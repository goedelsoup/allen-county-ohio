---
// The holdings of an office, from whichever corner the reader arrived at.
//
// A holding is a tenure node, and that is the point the boards keep making: the
// dates belong to the holding, not to the person and not to the seat. So the
// row is always the tenure, and only the column that would repeat the page's
// own subject is dropped.

import { entryPath, type Holding } from '../../lib/entry'

interface Props {
  holdings: Holding[]
  /** Which corner the reader is standing in — its own column is redundant. */
  view: 'seat' | 'holders' | 'offices'
  /** The tenure being read, where one is; its row is marked. */
  currentId?: string
}

const { holdings, view, currentId } = Astro.props
const showOffice = view === 'offices'
---

<ol class="holdings">
  {
    holdings.map((h) => (
      <li class:list={[h.tenure.id === currentId && 'is-this']}>
        <span class="span">
          {h.began || '—'}
          {h.ended ? `–${h.ended}` : '–'}
        </span>
        <span class="who">
          {showOffice ? (
            h.office ? (
              <a href={entryPath(h.office.id)}>{h.office.label}</a>
            ) : (
              <span class="absent">office not published</span>
            )
          ) : h.person ? (
            <a href={entryPath(h.person.id)}>{h.person.label}</a>
          ) : (
            <span class="absent">holder not published</span>
          )}
        </span>
        <span class="how">{h.howBegan || '—'}</span>
        <span class="how">
          {h.howEnded || (h.ended ? '—' : 'serving, or not established')}
        </span>
        <span class="link">
          {h.tenure.id === currentId ? (
            <span class="here">This term</span>
          ) : (
            <a href={entryPath(h.tenure.id)}>The term</a>
          )}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .holdings {
    list-style: none;
    margin: var(--space-5) 0 var(--space-9);
    padding: 0;
    border-bottom: 1px solid var(--ink-300);
  }
  li {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 104px 150px 68px;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--rule-hairline);
  }
  li:first-child {
    border-top: 1px solid var(--ink-300);
  }
  .span {
    font: var(--type-data);
    font-size: var(--size-label);
    color: var(--text-faint);
  }
  .is-this .span {
    color: var(--rubric-500);
  }
  .who {
    font: var(--weight-regular) var(--size-body-s) / 1.4 var(--font-serif);
    color: var(--text-body);
  }
  .absent {
    color: var(--text-faint);
  }
  .how,
  .link {
    font: var(--type-data);
    font-size: var(--size-micro);
    color: var(--text-faint);
  }
  .here {
    color: var(--rubric-500);
  }

  @media (width < 52rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>

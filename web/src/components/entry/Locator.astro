---
// Where the thing is, drawn on a graticule.
//
// The design's map cards are explicitly schematic — no plate scans and no
// geodata were supplied with the brief — but the corpus does carry real
// coordinates for places and sites, so the marker is placed by the county
// bounding box rather than by decoration. The card says which it is: the
// graticule is drawn, the point is measured.

interface Props {
  lat: number
  lon: number
}

const { lat, lon } = Astro.props

// Allen County's extent, generous enough that every corpus point falls inside.
const BOUNDS = { north: 40.99, south: 40.61, west: -84.46, east: -83.9 }

const clamp = (n: number) => Math.min(97, Math.max(3, n))
const x = clamp(((lon - BOUNDS.west) / (BOUNDS.east - BOUNDS.west)) * 100)
const y = clamp(((BOUNDS.north - lat) / (BOUNDS.north - BOUNDS.south)) * 100)

const fmt = (n: number, pos: string, neg: string) =>
  `${Math.abs(n).toFixed(4)}° ${n >= 0 ? pos : neg}`
---

<div class="plate">
  <span class="river"></span>
  <span class="marker" style={`left:${x}%;top:${y}%`}></span>
</div>
<p class="coords">{fmt(lat, 'N', 'S')} · {fmt(lon, 'E', 'W')}</p>
<p class="note">Graticule schematic; the marker is the recorded coordinate.</p>

<style>
  .plate {
    position: relative;
    height: 152px;
    margin-top: var(--space-4);
    background-color: var(--surface-map);
    background-image: var(--map-graticule);
    border: 1px solid var(--ink-200);
    box-shadow: inset 0 0 20px rgb(122 90 58 / 16%);
  }
  /* The Ottawa, indicatively: the county's one orienting line. */
  .river {
    position: absolute;
    left: 0;
    top: 54%;
    width: 100%;
    height: 2px;
    background: var(--map-water);
    opacity: 0.35;
    transform: rotate(-5deg);
  }
  .marker {
    position: absolute;
    width: 9px;
    height: 9px;
    margin: -5px 0 0 -5px;
    background: var(--map-marker);
    border: 1px solid var(--map-marker-edge);
    box-shadow: 0 0 0 4px rgb(166 64 44 / 18%);
  }
  .coords {
    margin: var(--space-4) 0 0;
    font: var(--type-data);
    font-size: var(--size-label);
    color: var(--text-body);
  }
  .note {
    margin: var(--space-2) 0 0;
    font: var(--weight-regular) var(--size-body-s) / 1.45 var(--font-serif);
    color: var(--text-muted);
  }
</style>

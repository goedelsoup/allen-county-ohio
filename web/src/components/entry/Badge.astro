---
// Sourcing status as content, not metadata.
//
// The badge always carries its word. Tier is a status role and a reader must never have to
// tell `verified` from `inference` by hue alone.

import Icon from './Icon.astro'
import { tierBadge } from '../../lib/entry'
import type { Tier } from '../../lib/feeds'

interface Props {
  tier: Tier
  label?: string
}

const { tier, label } = Astro.props
const badge = tierBadge(tier)
---

<span class:list={['badge', tier]}>
  <Icon name={badge.glyph} size={13} />
  {label ?? badge.label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 2px var(--space-3);
    border: 1px solid currentcolor;
    border-radius: var(--radius-sm);
    font-family: var(--font-smallcaps);
    font-size: var(--size-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .verified {
    color: var(--status-verified);
  }
  .inference {
    color: var(--status-disputed);
  }
  .open {
    color: var(--rubric-500);
  }
</style>

---
// A table that is the whole point, not a fallback behind a disclosure.
interface Props {
  title: string
  caption?: string
  columns: string[]
  rows: (string | number)[][]
}

const { title, caption, columns, rows } = Astro.props
---

<figure class="table-figure">
  <figcaption>
    <p class="fig-title">{title}</p>
    {caption && <p>{caption}</p>}
  </figcaption>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>

<style>
  .table-figure {
    margin: 0 0 2.5rem;
    padding: 1.5rem;
    background: var(--surface-card);
    border: 1px solid var(--rule-hairline);
    border-radius: var(--radius-md);
  }
  /* Not a heading, for the reason given in `ChartFigure.astro`. */
  figcaption .fig-title {
    margin: 0 0 0.25rem;
    color: var(--text-strong);
    font: var(--type-section);
  }
  figcaption p {
    margin: 0 0 1rem;
    color: var(--text-body);
    font-size: 0.9375rem;
    max-width: var(--measure-prose);
  }
  table {
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    min-width: 100%;
  }
  th,
  td {
    text-align: right;
    padding: 0.45rem 0.875rem 0.45rem 0;
    border-bottom: 1px solid var(--rule-hairline);
    white-space: nowrap;
  }
  thead th {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  th[scope='row'] {
    text-align: left;
    font-weight: 500;
    padding-right: 1.5rem;
  }
</style>

---
// A number that is its own chart.
//
// The commonest way a chart misses its point is being a chart at all when the story is one
// number. Proportional figures, not tabular: equal-width digits read loose at this size.
import Badge from './entry/Badge.astro'
import type { Tier } from '../lib/feeds'

interface Props {
  value: string
  label: string
  note?: string
  tier?: Tier
}

const { value, label, note, tier } = Astro.props
---

<div class="tile">
  <div class="value">{value}</div>
  <div class="label">{label}</div>
  {note && <p class="note">{note}</p>}
  {tier && <Badge tier={tier} scale="inline" />}
</div>

<style>
  .tile {
    background: var(--surface-card);
    border: 1px solid var(--rule-hairline);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }
  .value {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .label {
    color: var(--text-body);
    font-size: 0.9375rem;
  }
  .note {
    color: var(--text-muted);
    font-size: 0.8125rem;
    margin: 0.25rem 0 0.5rem;
  }
</style>

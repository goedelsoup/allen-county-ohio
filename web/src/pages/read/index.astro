---
import Base from '../../layouts/Base.astro'
import { ARTICLES, articlesIn, eraLabel, unresolvedDeclarations } from '../../lib/articles'
import { SECTION_KEYS, sectionLabel, sectionPath } from '../../lib/sections'

// The gate runs where the page renders, not only where it is tested: a declaration naming an
// assertion the publication gate withdrew must not reach a build at all.
const broken = unresolvedDeclarations()
if (broken.length > 0) {
  throw new Error(`article declarations do not resolve against the feed:\n  ${broken.join('\n  ')}`)
}

const groups = SECTION_KEYS.map((key) => ({ key, items: articlesIn(key) })).filter(
  (g) => g.items.length > 0,
)

const span = ARTICLES.reduce(
  (acc, a) => [Math.min(acc[0], a.era[0]), Math.max(acc[1], a.era[1])] as [number, number],
  [9999, 0] as [number, number],
)
---

<Base
  title="The reading room"
  lede={`${ARTICLES.length} shorter pieces, each resting on passages the corpus can cite — ${span[0]} to ${span[1]}. The six reading pages carry the county's argument; these carry the things that would have buried it.`}
>
  <nav class="jump" aria-label="Article groups">
    {
      groups.map(({ key, items }) => (
        <a href={`#${key}`}>
          {sectionLabel(key)}
          <span class="count">{items.length}</span>
        </a>
      ))
    }
  </nav>

  {
    groups.map(({ key, items }) => (
      <section id={key}>
        <h2>
          <a href={sectionPath(key)}>{sectionLabel(key)}</a>
          <span class="count">{items.length}</span>
        </h2>
        <ol class="pieces">
          {items.map((a) => (
            <li>
              <span class="era data">{eraLabel(a)}</span>
              <span class="body">
                <a class="ttl" href={`/read/${a.slug}`}>
                  {a.title}
                </a>
                <span class="dek">{a.dek}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <style>
    .jump {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
      border-top: 1px solid var(--rule-hairline);
      border-bottom: 1px solid var(--rule-hairline);
      padding: var(--space-4) 0;
      margin-bottom: var(--space-11);
    }
    .jump a {
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-3);
      font: var(--weight-medium) var(--size-body-s) / 1 var(--font-smallcaps);
      letter-spacing: var(--tracking-smallcaps);
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
    }
    .jump a:hover {
      color: var(--text-strong);
    }

    section {
      margin-bottom: var(--space-12);
    }

    h2 {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      font: var(--weight-regular) var(--size-title) / var(--leading-title) var(--font-display);
      color: var(--text-strong);
      border-bottom: 1px solid var(--rule-strong);
      padding-bottom: var(--space-4);
      margin: 0 0 var(--space-6);
    }
    h2 a {
      color: inherit;
      text-decoration: none;
    }
    h2 a:hover {
      text-decoration: underline;
      text-decoration-color: var(--rubric-500);
    }

    .count {
      font: var(--type-data);
      font-size: var(--size-micro);
      color: var(--text-faint);
    }

    .pieces {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .pieces li {
      display: grid;
      grid-template-columns: 8.5ch 1fr;
      gap: var(--space-6);
      padding: var(--space-5) 0;
      border-bottom: 1px solid var(--rule-hairline);
    }
    .era {
      font-size: var(--size-micro);
      color: var(--text-faint);
      letter-spacing: var(--tracking-mono);
      padding-top: 0.35em;
      white-space: nowrap;
    }
    .body {
      display: block;
      max-width: var(--measure-prose);
    }
    .ttl {
      display: block;
      font: var(--weight-regular) var(--size-subhead) / 1.3 var(--font-serif);
      color: var(--text-strong);
      text-decoration: none;
    }
    .ttl:hover {
      text-decoration: underline;
      text-decoration-color: var(--rubric-500);
    }
    .dek {
      display: block;
      margin-top: var(--space-3);
      font: var(--weight-regular) var(--size-body-s) / 1.5 var(--font-serif);
      color: var(--text-muted);
    }

    @media (width < 34rem) {
      .pieces li {
        grid-template-columns: 1fr;
        gap: var(--space-2);
      }
      .era {
        padding-top: 0;
      }
    }
  </style>
</Base>

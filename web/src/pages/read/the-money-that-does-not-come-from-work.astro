import ChartFigure from '../../components/ChartFigure.astro'
import Gloss from '../../components/Gloss.astro'
import { assertion } from '../../lib/feeds'
import { line } from '../../lib/chart-spec'

const grew = assertion('income-rose-and-earnings-barely-did')
const hole = assertion('twenty-years-to-get-back-to-1979')
const job = assertion('a-job-here-pays-what-it-paid-in-1969')
const half = assertion('half-the-growth-is-transfers')
const quarter = assertion('a-quarter-of-the-income-is-a-transfer')
const medical = assertion('half-the-transfers-are-medical')
const inverted = assertion('the-composition-inverted')
const two = assertion('two-federal-accounts-of-one-county')
const diff = assertion('the-difference-is-medicare-and-medicaid')
const ohio = assertion('ordinary-for-ohio-and-ohio-is-not-its-median')
const nation = assertion('the-gap-with-the-nation-is-in-the-growth-rate')

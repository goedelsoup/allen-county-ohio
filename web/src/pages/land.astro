---
import Base from '../layouts/Base.astro'
import AssertionCard from '../components/AssertionCard.astro'
import ChartFigure from '../components/ChartFigure.astro'
import DataTable from '../components/DataTable.astro'
import { assertion } from '../lib/feeds'
import { bar, line } from '../lib/chart-spec'

const farmland = assertion('the-county-is-two-thirds-farmland')
const hogs = assertion('the-hogs-multiplied-as-the-keepers-halved')
const rented = assertion('most-of-the-farmland-is-rented')
const yields = assertion('an-acre-yields-five-times-what-it-did')
const annexed = assertion('the-annexations-are-dated-now')
const birthdays = assertion('the-villages-have-birthdays-now')
const control = assertion('the-county-lost-land-it-never-lost')
const fourYears = assertion('a-fifth-of-the-farmland-went-in-four-years')
const winters = assertion('the-winters-warmed-and-the-summers-did-not')

const fourYearsSpec = bar(
  fourYears.figures.map((f) => f.label),
  fourYears.figures.map((f) => f.value),
  { yTitle: 'Acres of farmland lost, by stretch', labelValues: true },
)

// Winter against summer, from the assertion's own two figures, so the chart cannot drift from the
// prose the gate checked.
const wintersSpec = bar(
  winters.figures.map((f) => f.label),
  winters.figures.map((f) => f.value),
  { yTitle: 'Degrees Fahrenheit gained, 1895\u20131924 to 1996\u20132025', labelValues: true },
)

// The twelve months, both elements, at the two ends of the record. Typed out because the two
// columns come from two files and the point of the table is that they disagree in shape.
const monthChange = [
  ['January', '+1.19', '\u22120.15'],
  ['February', '+4.98', '+0.48'],
  ['March', '+2.18', '\u22120.52'],
  ['April', '+2.34', '+0.66'],
  ['May', '+1.30', '+1.14'],
  ['June', '+1.80', '+0.42'],
  ['July', '+0.22', '+0.27'],
  ['August', '+1.00', '+0.43'],
  ['September', '+1.39', '+0.35'],
  ['October', '+1.91', '+0.36'],
  ['November', '+2.25', '+0.11'],
  ['December', '+3.79', '+0.11'],
]

// Decade means, both elements, with the county's heating and cooling demand beside them.
const climateDecades = [
  ['1900s', '49.25', '35.21', '6,447', '754'],
  ['1910s', '49.44', '35.61', '6,398', '770'],
  ['1920s', '49.90', '36.86', '6,205', '732'],
  ['1930s', '51.22', '33.78', '5,963', '979'],
  ['1940s', '50.51', '34.86', '6,077', '836'],
  ['1950s', '50.28', '36.65', '6,128', '797'],
  ['1960s', '49.18', '31.73', '6,442', '712'],
  ['1970s', '49.56', '35.22', '6,358', '776'],
  ['1980s', '50.19', '35.07', '6,190', '831'],
  ['1990s', '50.87', '37.06', '5,888', '771'],
  ['2000s', '51.05', '38.54', '5,861', '811'],
  ['2010s', '51.60', '42.07', '5,788', '945'],
]

// The seven census years the corpus now holds for land in farms. Typed out because they come
// from four different sources and the point of the table is that they are one series.
const farmSeries = [
  ['1910', '2,939', '240,472', '92.5%', 'Thirteenth Census'],
  ['1950', '2,560', '227,944', '—', '1954 volume, prior-year column'],
  ['1954', '2,097', '215,018', '81.9%', '1954 Census of Agriculture'],
  ['1982', '1,202', '197,256', '—', '1987 volume, prior-year column'],
  ['1987', '1,148', '201,190', '77.7%', '1987 Census of Agriculture'],
  ['2002', '968', '188,150', '—', 'Census of Agriculture'],
  ['2022', '897', '178,921', '69.4%', 'Census of Agriculture'],
]

// Bars, not a line. The 1910 observation and the 2002 one are ninety-two years apart and
// nothing measured between them; a line would draw that segment, and its shape is exactly
// what this corpus refuses to assert.
const farmlandSpec = bar(
  farmland.figures.map((f) => f.label),
  farmland.figures.map((f) => f.value),
  { yTitle: 'Acres in farms' },
)

const hogSpec = line(
  hogs.figures.map((f) => f.label),
  [{ name: 'Hogs on 31 December', y: hogs.figures.map((f) => f.value) }],
  { yTitle: 'Head', labelLast: true, zeroBased: true },
)

const bridges = assertion('not-one-state-bridge-is-in-poor-condition')
const gauge = assertion('the-gauge-was-not-there')
const drinks = assertion('the-city-drinks-from-the-river-nobody-measures')
const named = assertion('a-county-column-is-a-filing-decision')
const houses = assertion('the-houses-went-where-the-city-is-not')

const housesSpec = bar(
  houses.figures.map((f) => f.label),
  houses.figures.map((f) => f.value),
  { yTitle: 'Single-family houses authorized, 1990–2025', labelValues: true },
)

const permitDecades = [
  ['1990–1999', 2252, 2941, '225.2'],
  ['2000–2009', 1952, 2159, '195.2'],
  ['2010–2019', 587, 1025, '58.7'],
  ['2020–2025', 638, 844, '106.3'],
]

const namedSpec = bar(
  named.figures.map((f) => f.label),
  named.figures.map((f) => f.value),
  { yTitle: 'Named features standing on Allen County ground', labelValues: true },
)

// Typed out: eleven streams the gazetteer files in another county because that is where they end.
const lost = [
  ['Auglaize River', 'Defiance'],
  ['Big Run', 'Putnam'],
  ['Cranberry Creek', 'Putnam'],
  ['Cranberry Run', 'Putnam'],
  ['Flat Fork', 'Putnam'],
  ['Jennings Creek', 'Putnam'],
  ['Little Riley Creek', 'Hardin'],
  ['Ottawa River', 'Putnam'],
  ['Plum Creek', 'Putnam'],
  ['Rattlesnake Creek', 'Putnam'],
  ['Sugar Creek', 'Putnam'],
]

const bridgeSpec = bar(
  bridges.figures.map((f) => f.label),
  bridges.figures.map((f) => f.value),
  { yTitle: 'Per cent of bridges in poor condition', labelValues: true },
)

const annexedSpec = bar(
  annexed.figures.map((f) => f.label),
  annexed.figures.map((f) => f.value),
  { yTitle: 'Acres reported annexed, 1990–2024', labelValues: true },
)

const yieldSpec = bar(
  yields.figures.map((f) => f.label),
  yields.figures.map((f) => f.value),
  { yTitle: 'Bushels per acre', labelValues: true },
)
---

<Base
  title="Land"
  lede="Two thirds of Allen County is farms. This is what stands on that ground, who owns it, what it grows, and where the lines drawn around it have moved."
>
  <section>
    <h2>The other nine-tenths</h2>
    <p>
      This site spent eleven phases on the third of the county that lives in Lima and said nothing
      about the two thirds of its surface that is farmland. The federal agricultural census has been
      taken every five years since long before any of the rest of this, and until now the corpus had
      read exactly one of them — the volume for 1909, which found the county 92.5 per cent farms.
    </p>
    <AssertionCard assertion={farmland} />
    <ChartFigure
      id="farmland"
      title="Land in farms"
      caption="Census of Agriculture. There is no observation between 1910 and 2002: the bars are five years apart at the right-hand end and ninety-two years apart at the left, and nothing here says what the line did in between."
      columns={['Census', 'Acres in farms']}
      rows={farmland.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
    />
    <script type="application/json" data-chart-spec="farmland" set:html={JSON.stringify(farmlandSpec)} is:inline />
    <p>
      That is the shape of the gap and it is worth stating plainly. Of the 61,551 acres that left
      the county's farms, 52,322 went before the first census this corpus can read. It knows the
      farmland went. It cannot say whether it went in one decade or in nine, and a county that lost
      fifty thousand acres to drainage, to the oil field, to Lima's annexations or to the interstate
      lost them for four different reasons.
    </p>
  </section>

  <section>
    <h2>A hog county</h2>
    <p>
      The county profile the census publishes for a general reader leads with farms, land and sales,
      and all three of them barely move. The figure that moved is an inventory row on the second
      page.
    </p>
    <AssertionCard assertion={hogs} />
    <ChartFigure
      id="hogs"
      title="Hogs in Allen County, 2002–2022"
      caption="Inventory at 31 December of each census year. The operations holding them went 59, 60, 46, 56, 28 across the same five censuses."
      columns={['Census', 'Head']}
      rows={hogs.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
    />
    <script type="application/json" data-chart-spec="hogs" set:html={JSON.stringify(hogSpec)} is:inline />
    <p>
      Hogs are $75.3 million of the county's $240.8 million of agricultural sales, which is fourth
      in Ohio. Of 377,816 head sold in 2022, 281,194 were raised under production contract on twelve
      operations — the census's own term for an animal fed by one party and owned by another. In
      2017 it was 144,480 of 324,947 on twenty-one. The share went from 44 per cent to 74 while the
      number of places doing it fell by nine.
    </p>
    <p>
      In 1910 this county held 59,695 swine and 56,580 people, and the measure written from that
      census observed that the swine outnumbered the people. They still do, by 235,800 to 100,866.
      Everything else in the 1910 count is gone: 14,676 horses became 316, 41,240 sheep and goats
      became 1,499, and the 10,671 dairy cows became a figure the census will not print, because
      eight operations hold it and one is large enough that the total would disclose it.
    </p>
  </section>

  <section>
    <h2>Who owns it</h2>
    <AssertionCard assertion={rented} />
    <p>
      The county had 2,939 farms in 1910 and 897 in 2022, and this site does not subtract the one
      from the other. A farm in 1910 was land under one manager, with nothing under three acres
      counted unless it produced $250; a farm in 2022 is any place selling $1,000 or more. Two
      counts on two thresholds are not a series. What is comparable is acres, animals and bushels,
      and those are what every figure on this page is made of.
    </p>
  </section>

  <section>
    <h2>What it grows</h2>
    <AssertionCard assertion={yields} />
    <ChartFigure
      id="yields"
      title="Yield per harvested acre, 1909 and 2022"
      caption="Production divided by harvested acres, from the two censuses' own figures for both terms. Neither census reports yield this way; the ratio is computed here because both print the numerator and the denominator."
      columns={['Crop and year', 'Bushels per acre']}
      rows={yields.figures.map((f) => [f.label, f.value.toFixed(1)])}
    />
    <script type="application/json" data-chart-spec="yields" set:html={JSON.stringify(yieldSpec)} is:inline />
    <p>
      Soybeans and corn are 84.9 per cent of the county's cropland. The rest is 9,252 acres of
      wheat, 2,686 of hay and haylage, 793 of popcorn on fourteen operations, and $1.66 million of
      vegetables, fruit, nursery stock and everything else together. The crops that fed the horses
      went with them: 30,156 acres of oats in 1909 and 11 acres in 2022, and where there were 3,107
      acres of rye there is now one operation in the county growing it, whose acreage the census
      withholds because one operation is all there is.
    </p>
  </section>

  <section>
    <h2>Where the lines moved</h2>
    <p>
      Until this phase the corpus held three dated boundary changes for the whole county — 1903,
      1905 and 1944, all of them footnotes in census volumes — and said so in nine different nodes,
      each warning that a population or area figure for Lima describes whatever ground the
      corporation held on the day. The Census Bureau collects annexations through a survey it runs
      every year and publishes the answers by state. Ohio's files hold fifty-seven for this county.
    </p>
    <AssertionCard assertion={annexed} />
    <ChartFigure
      id="annexed"
      title="Acres reported annexed, 1990–2024"
      caption="What each municipality told the Boundary and Annexation Survey it had annexed, summed over every record with an acreage. Five of the fifty-seven records state none, so every bar is a floor. Delphos and Bluffton cross county lines and their totals include ground on the Van Wert and Hancock sides."
      columns={['Municipality', 'Acres']}
      rows={annexed.figures.map((f) => [f.label, f.value.toFixed(1)])}
    />
    <script type="application/json" data-chart-spec="annexed" set:html={JSON.stringify(annexedSpec)} is:inline />
    <p>
      Lima's eleven acts are the shape of it: fifteen acres in 1990, six in 1991, then ten and a
      half years in which the city reported nothing, then 601 acres in eight annexations between
      June 2002 and December 2009, then one act in June 2017 and nothing since. Ordinance 90-02 of
      24 June 2002, at 215.9 acres, is the largest single annexation in the county's record and the
      one that ends the pause.
    </p>
    <p>
      Elida is the entry that does not work. Five records totalling 912.9 acres, for a village that
      occupies 745.6 — and one of the five, ordinance 622-92 of March 1992, claims exactly 640.0
      acres, which is a square mile to the acre and the size of a survey section rather than of a
      parcel. Reported acreage is what a clerk wrote on a form. It is not a survey, and this site
      does not treat it as one.
    </p>
    <p>
      Two of the fifty-seven changed something larger than a village. Between the 1990 and 2000
      censuses Marion Township took ground from Jennings Township across the line in Putnam County,
      which moved <strong>the county's own outline</strong> — the second time those two townships
      have exchanged ground, the first being the reorganization of 1848. In the same decade Jackson
      Township lost ground to Bath, which is the only township-to-township transfer on record here
      after 1848 and carries no ordinance number anywhere, because a township is not a reporting
      entity in the survey.
    </p>
    <AssertionCard assertion={control} />
    <p>
      Having the annexations does not make the area figures comparable, and finding out why was the
      more useful half of this work. The Census Bureau's land-area column moves for two reasons —
      ground changing hands, and the same ground being remeasured on better coordinates — and
      prints as one number. Allen County's land area falls from 404.43 square miles in the 2000
      volume to 402.50 in the 2010 one while its total area holds at 406.88 and 406.85. Nothing
      left the county; twelve hundred acres crossed from the land column to the water column.
    </p>
    <p>
      So eleven of the twelve townships show less land in 2010 than in 2000, including seven that
      gave ground to nobody, and Perry — which did give ground to Lima — shows the largest fall in
      the county at 474 acres, indistinguishable from Amanda's 128. The rule this site now applies
      is to read every area change against something in the same table that could not have moved.
      For the subdivisions that is the county; for the county it is its own total.
    </p>
    <p>
      Lima survives that test by a factor of eight, and the check it survives is worth stating
      plainly. The city reported 601 acres of annexation to the survey across the 2000s. The Census
      Bureau, measuring a polygon and not reading a form, found Lima's total area larger by 582.4
      acres between the two censuses. A city clerk's eight forms and a federal boundary file agree
      to three per cent, and neither knew about the other.
    </p>
  </section>
  <section>
    <h2>What crosses the water</h2>
    <p>
      Three hundred and sixty-four highway bridges stand in Allen County. Forty-one of them cross
      the Ottawa River — nearly twice as many as cross the Auglaize, which is the larger river, and
      the difference is Lima: the Auglaize runs through farmland and the Ottawa runs through the
      county seat, where every street has to get over the water. Twenty-two cross the Auglaize,
      twenty Sugar Creek, fourteen Riley Creek.
    </p>
    <AssertionCard assertion={bridges} />
    <ChartFigure
      id="bridgecond"
      title="Bridges in poor condition, by who owns them"
      caption="Poor is the lowest of the deck, superstructure, substructure and culvert ratings being 4 or less, which is the Federal Highway Administration's own rule. The three owners hold 103, 242 and 19 structures. No township in Ohio owns a bridge: state law puts them all on the county engineer and the commissioners."
      columns={['Owner', 'Per cent poor']}
      rows={bridges.figures.map((f) => [f.label, f.value.toFixed(1)])}
    />
    <script type="application/json" data-chart-spec="bridgecond" set:html={JSON.stringify(bridgeSpec)} is:inline />
    <p>
      Why the state's hundred and three are all sound is not in this file. Two readings fit — that
      the state maintains better, or that the state owns the newer and larger structures, most of
      them on an interstate built in the 1960s — and nothing in the inventory separates them. What
      can be said is which number belongs to which government: twelve per cent is the county
      engineer's figure, not nine.
    </p>
    <p>
      The county's own site says it has 371 bridges and more than 1,400 culverts; the federal
      inventory holds 364. Neither is wrong. A structure enters this inventory only if it spans more
      than twenty feet, and the rule holds in the data — the shortest of the 364 is 6.4 metres
      against a threshold of 6.1, with no exception. The seven are not missing. They are short.
    </p>
    <p>
      Half the county's bridges predate 1980, and the peak is the interstate decades: 69 built in
      the 1960s and 72 in the 1970s, thirty-nine per cent of them in twenty years. The oldest was
      built in 1909 and still carries Hay Road over the Auglaize River in Auglaize Township. It is
      the only one of the 364 the federal file marks as eligible for the National Register, and none
      of the county's twenty-nine Register entries is a bridge. It has no name in the record — only
      a road, a river, and the structure number 0234753.
    </p>
    <p>
      One caution about the traffic figures here. The busiest structure in the county carries
      Interstate 75 over Lost Creek at 39,060 vehicles a day — a count taken in 2015 and printed in
      the 2025 file, as are the counts on 293 of the county's 364 bridges. The edition year dates the
      compilation and nothing inside it.
    </p>
  </section>

  <section>
    <h2>The river, measured</h2>
    <p>
      Allen County holds 184 USGS water monitoring sites — ninety groundwater wells, thirty-one lake
      stations, twenty-nine on streams — and two usable records of how much water a river carries. A
      county can be thick with instruments and thin with measurements.
    </p>
    <p>
      Both are on the Ottawa, and they are in two halves that cannot be joined. A gauge at Allentown
      ran from 1924 to 1981 over 160 square miles of drainage; one at Lima has run since 1989 over
      128. Seven water years separate them. The largest flow ever measured on this river is 7,740
      cubic feet a second, on 22 January 1959 — more than twice the median annual peak and nineteen
      per cent above the next largest. The Auglaize is the bigger river and has no peak record at
      all, which is the same asymmetry the bridges show: forty-one crossings of the Ottawa against
      twenty-two of the Auglaize, because Lima sits on the Ottawa.
    </p>
    <AssertionCard assertion={gauge} />
    <p>
      There is an obvious thing to do with a flow record and a list of federal disaster
      declarations, and it does not work. The county has four declarations for storms and flooding —
      2004, 2005, 2007 and 2012 — and the Lima gauge is missing water years 2000 to 2009 exactly.
      Three of the four fall inside the hole. The fourth, June 2012, is titled for straight-line
      winds, and that water year's peak ranked sixteenth of twenty-seven and was not in that storm.
    </p>
    <p>
      What survives the check is one half of the striking sentence. The largest measured flood in
      the modern record — 5,700 cubic feet a second on 28 February 2011 — brought no federal
      declaration, and neither did the second largest in 2015. That is a statement about the FEMA
      file, which is complete for those years and does not have this county in it. "No large flow in
      2004" would be a statement about nothing at all: the gauge was switched off.
    </p>
  </section>

  <section>
    <h2>Where the county drinks from</h2>
    <p>
      Eight community water systems serve 84,476 people in Allen County, and six of them are a town
      — Lima, Delphos, Bluffton, Elida, Spencerville and Beaverdam. The other two are a mobile home
      park and a campground. Against the county's 100,866 in 2024 that leaves about one person in
      six on none of them, though the figure is loose: these are self-reported service populations,
      and Bluffton and Delphos both straddle county lines.
    </p>
    <AssertionCard assertion={drinks} />
    <table>
      <caption>Community water systems, 2026</caption>
      <thead><tr><th scope="col">System</th><th scope="col">Served</th><th scope="col">Connections</th><th scope="col">Its own sources</th></tr></thead>
      <tbody>
        <tr><td>Lima City</td><td>65,619</td><td>27,113</td><td>6 reservoirs, 4 river intakes</td></tr>
        <tr><td>Delphos City</td><td>7,101</td><td>2,750</td><td>1 river intake, 1 reservoir, 9 wells</td></tr>
        <tr><td>Bluffton Village</td><td>4,125</td><td>1,505</td><td>8 wells, and a purchase</td></tr>
        <tr><td>Elida Village</td><td>4,109</td><td>1,684</td><td>none — it buys from Lima</td></tr>
        <tr><td>Spencerville Village</td><td>2,261</td><td>1,000</td><td>5 wells</td></tr>
        <tr><td>Brightstar Lima MHP</td><td>480</td><td>204</td><td>1 well</td></tr>
        <tr><td>Sun Valley Campground</td><td>462</td><td>244</td><td>1 well</td></tr>
        <tr><td>Beaverdam Village</td><td>319</td><td>170</td><td>3 wells</td></tr>
      </tbody>
    </table>
    <p>
      Lima's system serves nearly twice the city's own population and sells to Elida on top of it,
      and every drop of it is surface water that has been stored first: six named reservoirs —
      Ferguson, Bresler, Metzger, Williams, Twin Lakes and Lost Creek — each with its own intake,
      plus four more on the Ottawa and the Auglaize. That is also the answer to something the last
      section raised: a county with no natural lakes has thirty-one lake and reservoir monitoring
      stations because a city's water supply is standing in them.
    </p>
    <p>
      Two of those intakes are on the Auglaize, which drains 219 square miles above Spencerville and
      has never had a year of peak flow recorded. The county's largest water system draws on the
      river nobody measures, and the gauged one is the smaller.
    </p>
    <p>
      The compliance record runs to 197 violations across thirty-eight systems since 1984, of which
      twenty concern the water and the rest concern monitoring, reporting and record-keeping. All
      twenty have been resolved — and there are ten resolutions between them, because Bluffton was
      over a standard for ten consecutive quarters from October 2013 and cleared all ten on one day
      in April 2016. Counting the rows would put a village's single two-and-a-half-year failure
      ahead of a city's three separate ones.
    </p>
    <p>
      The violation count rises steeply — two in the 1980s, 24 in the 1990s, 25 in the 2000s, 61 in
      the 2010s, 85 in the six years since 2020 — and nearly all of the increase is paperwork. The
      number of federal drinking water rules to be monitored under grew across the same span. The
      count is recorded here and the trend is not.
    </p>
  </section>

  <section>
    <h2>When the villages began</h2>
    <AssertionCard assertion={birthdays} />
    <p>
      Allen County has nine municipal corporations, and until this phase five of them had no
      founding date on this site. Four of the five turned out to be in the three county histories
      of 1885, 1906 and 1921 — books this site has quoted for mayors, for railroads, for townships
      and for a jail raid, and had never once asked when the villages were incorporated. No source
      was fetched to close them.
    </p>
    <table>
      <thead>
        <tr><th>Corporation</th><th>Authorised</th><th>First mayor</th></tr>
      </thead>
      <tbody>
        <tr><td>Lima</td><td>29 March 1842</td><td>H. D. V. Williams</td></tr>
        <tr><td>Delphos</td><td>7 February 1851</td><td>Lester Bliss</td></tr>
        <tr><td>Bluffton</td><td>17 August 1861</td><td>J. S. Powell</td></tr>
        <tr><td>Spencerville</td><td>1867</td><td>J. C. Campbell</td></tr>
        <tr><td>Lafayette</td><td>3 September 1867</td><td>M. C. Murnagh</td></tr>
        <tr><td>Cairo</td><td>12 April 1875</td><td>Dr. J. S. Clippinger</td></tr>
        <tr><td>Elida</td><td>1878</td><td>B. B. Murray</td></tr>
        <tr><td>Beaverdam</td><td>13 May 1878</td><td>Joseph Shull</td></tr>
        <tr><td>Harrod</td><td>between 1885 and 1890</td><td>—</td></tr>
      </tbody>
    </table>
    <p>
      "Incorporated" is not one act. Lima, Lafayette, Cairo and Beaverdam were organized on the
      county commissioners' authority after a petition; Delphos and Spencerville by an act of
      incorporation; and Bluffton by a ballot on 17 August 1861 that settled the incorporation and
      the name in the same vote. The town had been platted in 1837 as Shannon. Its post office kept
      that name for another twelve years — which is why the 1885 history dates the change to 1872–73
      and adds that "long prior to this the latter name was bestowed upon it". Long prior was 1861.
    </p>
    <p>
      Cairo went the other way. The ground was platted as West Cairo in 1848 and the corporation
      organized as Cairo Village in 1875, on the petition of forty-one men; the 1921 history was
      still calling the incorporated village West Cairo in 1920, and the place did not officially
      take the shorter name until 1922. A place and the corporation over it carried different names
      for forty-seven years.
    </p>
    <p>
      Two absences are left and they are not the same kind of thing. Harrod is missing from the 1885
      history, appears as a village of 269 in the 1890 census and is a taxed corporation by 1904, so
      its founding is bounded to five years and sits in the county commissioners' journal, which
      nobody here has opened. Bath Township's is not bounded and never will be: the 1885 compiler
      found "no record of its establishment either in the records of Allen or Mercer County", and
      the 1921 compiler, working independently thirty-six years later, reported the same. That blank
      belongs to the record rather than to this corpus, and it is the only one of the county's
      thirty-eight jurisdictions of which that can be said.
    </p>
  </section>

  <section>
    <h2>Counted two ways</h2>
    <AssertionCard assertion={named} />
    <p>
      The federal gazetteer is the authority on what things in this country are called. Ask it for
      Allen County's named features by its county column and it returns 109. Test every Ohio
      feature's coordinates against the county's own boundary instead and it returns 120.
    </p>
    <ChartFigure
      id="named-features"
      title="Named features standing on Allen County ground, by class"
      caption="Counted by coordinate rather than by the file's county column. The two methods agree exactly on every class but one: streams, where the column gives 21 and the ground gives 33."
      columns={['Feature class', 'Count']}
      rows={named.figures.map((f) => [f.label, f.value])}
    />
    <script type="application/json" data-chart-spec="named-features" set:html={JSON.stringify(namedSpec)} is:inline />
    <p>
      The whole of the difference is one class and one direction. A stream is filed under the county
      where it ends, so eleven watercourses that rise in Allen County are on another county's books
      — including the Ottawa River, which runs through the middle of Lima and is recorded under
      Putnam.
    </p>
    <DataTable
      caption="Eleven streams that rise in Allen County and are filed elsewhere, with the county each is filed under. A twelfth, Wrestle Creek, runs the other way: its mouth is 426 metres inside this county and the file puts it in Auglaize."
      columns={['Stream', 'Filed under']}
      rows={lost}
    />
    <p>
      Counting by ground loses exactly one feature in return, and it is Delphos — filed under Allen
      County with a point that falls in Van Wert. That is now the third independent source to catch
      the straddle, after the Census Bureau's part-rows and an attorney register's self-reported
      county.
    </p>
    <p>
      A few other things fall out of reading the file rather than filtering it. Three names in the
      county are used twice: two Little Riley Creeks, two Marsh Runs, and two Spencerville
      Reservoirs 761 metres apart. Fourteen still waters are named and not one is natural. Seven
      features are classed Canal and all seven are field ditches, while the county's actual canal
      appears only as Deep Cut, classed Channel. And the gazetteer and the city of Lima do not agree
      about Lima's reservoirs: the city names six, the gazetteer carries four of them, has no
      Bresler anywhere in Ohio, and adds eight the city does not name.
    </p>
  </section>

  <section>
    <h2>The houses went where the city is not</h2>
    <AssertionCard assertion={houses} />
    <p>
      Between 1990 and 2025 Allen County authorized 5,437 new single-family houses. Lima — a third
      of the county's population — was issued 367 of them, 6.8 per cent. American Township took
      1,098, Shawnee Township 981 and Bath Township 643: the three townships that wrap around the
      city account for half of everything the county built in thirty-six years.
    </p>
    <ChartFigure
      id="new-houses"
      title="Single-family houses authorized, 1990–2025, the four busiest places"
      caption="A permit is authorization to build, not a building. It says nothing about whether the work was done or whether anything was demolished to make room."
      columns={['Place', 'Houses']}
      rows={houses.figures.map((f) => [f.label, f.value])}
    />
    <script type="application/json" data-chart-spec="new-houses" set:html={JSON.stringify(housesSpec)} is:inline />
    <p>
      The money follows the same line. A new house in Shawnee Township was reported to the permit
      office at $211,559 and one in Lima at $95,879 — the city is the cheapest of the county's ten
      busiest places to build in, by a factor of two against its southern neighbour. Lima is also
      the only place in the county that builds apartments: 734 of the county's 774 dwellings in
      buildings of five units or more were authorized inside it, and Delphos has the other forty.
    </p>
    <DataTable
      title="Thirty-six years, four decades"
      caption="Reported construction value across the whole span is $968,246,660, in the dollars of each year and not adjusted. Twenty-three of the thirty-six years contain no apartment building of five units or more at all."
      columns={['Decade', 'Single-family', 'All dwellings', 'Houses a year']}
      rows={permitDecades}
    />
    <p>
      The peak year is 2004, at 331 houses, and the floor is 2011, at 35 — an 89.4 per cent fall in
      seven years, and the recovery has not come close to reversing it. But the sharper number is
      the one that pairs with the census. Between 1990 and 2020 the county lost 7,549 people and
      Lima lost 9,970, which means the ground outside the city gained 2,421. Allen County's
      depopulation is, over these thirty years, half relocation — and the permits say which half
      mile it moved to.
    </p>
  </section>


  <section>
    <h2>A fifth of the farmland went in four years</h2>
    <AssertionCard assertion={fourYears} />
    <p>
      Two days ago this site could say that Allen County was 92.5 per cent farmland in 1910 and is
      69.4 per cent farmland now, and could not say a word about the ninety-two years between. The
      printed census volumes for 1954 and 1987 are scanned on archive.org, and each of them prints
      the census before it in the next column — so two books gave four census years, and the fall
      turns out not to have been steady at all.
    </p>
    <DataTable
      title="Land in farms, seven census years"
      caption="The 1950 and 1982 figures are the prior-year columns of the 1954 and 1987 volumes, which is what makes each pair comparable: one publisher, one table, one set of column headings. The proportions are the ones the volumes print, against land areas that themselves move a little between censuses."
      columns={['Year', 'Farms', 'Acres in farms', 'Share of the county', 'Source']}
      rows={farmSeries}
    />
    <ChartFigure
      id="farmland-stretches"
      title="Acres of farmland lost, by stretch of the record"
      caption="Four bars of roughly equal height. Three of them are forty, twenty-eight and forty years long. The second is four."
      columns={['Stretch', 'Acres lost']}
      rows={fourYears.figures.map((f) => [f.label, f.value])}
    />
    <script type="application/json" data-chart-spec="farmland-stretches" set:html={JSON.stringify(fourYearsSpec)} is:inline />
    <p>
      Between 1950 and 1954 the county lost 12,926 acres of farmland — 3,232 a year, against 313 a
      year for the forty years before it — and 18.1 per cent of its farms. It is not a local event:
      Ohio lost 4.66 per cent of its land in farms over the same four years and this county 5.67,
      and Ohio lost 11.2 per cent of its farms against Allen's 18.1. The county falls harder than
      the state and in the same direction, which is what a national turn looks like. The known break
      in the census's definition of a farm is 1959, outside this pair.
    </p>
    <p>
      Two other things the record now dates. Between 1954 and 1982 the county lost 17,762 acres of
      farmland and gained 16,749 acres of harvested cropland — the two nearly cancel, so what left
      was pasture, woodland and farmstead rather than the ground under the corn. And the only rise
      in the whole series, 3,934 acres between 1982 and 1987, happens while an acre of Allen County
      farmland loses a quarter of its value, $2,023 to $1,504. In the same five years the county's
      "other cropland" went from 3,593 acres to 20,121. Land retired from production is still land
      in farms.
    </p>
    <p>
      And the crop changeover has a date. In 1949 the county harvested 26,213 acres of oats and
      17,393 of soybeans; in 1954, 22,498 of oats and 22,991 of soybeans. The crop that did not
      exist in this county in 1909 had passed the one that fed its horses before the interstate was
      built — and the oats survived that crossing at 22,498 acres and were down to eleven by 2022.
    </p>
  </section>

  <section>
    <h2>The weather the farms are in</h2>
    <p>
      Everything above is about ground. This site has never said anything about the sky over it, and
      it now has a hundred and thirty-one complete years of it — every month from January 1895,
      county by county, from NOAA's gridded climate record. Allen County is 2.03&nbsp;°F warmer than
      it was. Where that warmth went is the finding.
    </p>
    <AssertionCard assertion={winters} />
    <ChartFigure
      id="winter-against-summer"
      title="Degrees gained, winter against summer"
      caption="December–January–February and June–July–August, comparing the thirty years 1895–1924 with the thirty years 1996–2025. The annual mean rose 2.03 °F and reports neither of these."
      columns={['Season', 'Degrees gained']}
      rows={winters.figures.map((f) => [f.label, f.value])}
      height={280}
    />
    <script type="application/json" data-chart-spec="winter-against-summer" set:html={JSON.stringify(wintersSpec)} is:inline />
    <p>
      The mean daily maximum of June, July and August was 82.48&nbsp;°F in 1895–1924 and is
      82.59&nbsp;°F in 1996–2025 — eleven hundredths of a degree in a century. The hottest summers
      here are still 1934 and 1936, and the county's cooling-degree-day record, set in 1934, has
      stood for ninety-two years. The warmest <em>years</em>, meanwhile, are nearly all recent: 2024
      is the warmest of the hundred and thirty-one, and eight of the ten warmest are since 1991. A
      record that puts its hottest summers in the 1930s and its warmest years in the 2020s is
      describing a winter.
    </p>
    <DataTable
      title="What each month gained, 1895–1924 against 1996–2025"
      caption="Temperature in degrees Fahrenheit, precipitation in inches. Nights warmed faster than days — the minimum rose 2.36 degrees against the maximum's 1.70 — and two months are drier than they were."
      columns={['Month', 'Temperature', 'Precipitation']}
      rows={monthChange}
    />
    <p>
      The rain went up 3.66 inches a year, and 3.27 of those inches fall between April and September
      — a sixth more water on the growing season than the county's farms had a century ago, at the
      same time as the frost-season warmth that lets a crop start earlier. March, meanwhile, is
      half an inch drier than it was.
    </p>
    <DataTable
      title="Allen County by decade, 1900s to 2010s"
      caption="The trend is not a line: the 1930s are as warm as the 2000s, the 1960s as cold as the 1900s and drier than any decade of the record, and the 2010s the wettest by three and a half inches. Heating demand is down a tenth since 1895–1924 and cooling demand up a seventh."
      columns={['Decade', 'Mean °F', 'Precipitation (in)', 'Heating °days', 'Cooling °days']}
      rows={climateDecades}
    />
    <p class="note">
      Two instruments that share no data agree about which years were wet here. The wettest month in
      the record is June 2015 at 13.48 inches and the second is August 2007 at 10.54 — and August
      2007 falls inside the ten-year hole in the Lima river gauge, one of three federal flood
      declarations this site could previously say nothing about. The gauge's own highest peak, 5,700
      cubic feet a second on 28 February 2011, sits in the fourth wettest February of the record and
      the wettest calendar year of it. The rainfall record cannot say what was in the river; it can
      say what fell on the ground, and it is not silent where the gauge is.
    </p>
  </section>
</Base>

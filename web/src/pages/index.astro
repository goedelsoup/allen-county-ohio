---
import Base from '../layouts/Base.astro'
import AssertionCard from '../components/AssertionCard.astro'
import Claim from '../components/Claim.astro'
import StatTile from '../components/StatTile.astro'
import { assertion, manifest, node, seriesById } from '../lib/feeds'

const population = seriesById('place-allen-county::total-resident-population')
const latest = population.points[population.points.length - 1]
const first = population.points[0]

const landArea = seriesById('place-allen-county::land-area').points[0]
const precincts = seriesById('jurisdiction-allen-county-government::voting-districts').points[0]

const county = node('place/allen-county.yml')
const opening = county?.blocks[0]

const three = assertion('three-places')
const address = assertion('an-address-is-not-a-municipality')
const decline = assertion('county-population-decline')
---

<Base
  title="Allen County, Ohio"
  lede="A county of about a hundred thousand people in the northwest quarter of the state, seated at Lima. This site publishes what a documentary corpus can establish about it — and marks the places where it cannot."
>
  <div class="reading">
  <section class="tiles">
    <StatTile
      value={Number(latest.value).toLocaleString('en-US')}
      label="People, 2024 estimate"
      note={`Down from ${Number(first.value).toLocaleString('en-US')} in ${first.as_of}.`}
      tier={latest.tier}
    />
    <StatTile
      value={`${landArea.published}`}
      label="Square miles of land"
      note="2020 Census geography."
      tier={landArea.tier}
    />
    <StatTile
      value={precincts.published}
      label="Voting precincts"
      note="Not one crosses a civil-subdivision line."
      tier={precincts.tier}
    />
    <StatTile
      value={String(manifest.corpus.nodes)}
      label="Nodes in the corpus"
      note={`${manifest.corpus.edges} edges, each carrying the kind of claim it makes.`}
    />
  </section>

  {
    opening && (
      <section class="opening">
        <h2>The ground</h2>
        <Claim block={opening} />
      </section>
    )
  }

  <section>
    <h2>Three things worth knowing</h2>
    <p class="section-lede">
      Each of these is an assertion this site makes. None of them is a sentence any single
      corpus node contains, so each one shows the passage it was drawn from and the tag that
      passage carries.
    </p>
    <AssertionCard assertion={three} />
    <AssertionCard assertion={decline} />
    <AssertionCard assertion={address} />
  </section>

  <section class="onward">
    <h2>Where to go</h2>
    <p class="section-lede">
      Five sections, each answering one question and ending when it has. What would have
      buried them is in the reading room: thirty-seven shorter pieces, each resting on
      passages the corpus can cite.
    </p>
    <ul>
      <li>
        <a href="/ground">Ground</a>
        <span class="why">
          Two thirds of the county is farms, and the thing that changed on that ground since
          1910 is not the crops.
        </span>
      </li>
      <li>
        <a href="/people">People</a>
        <span class="why">
          Five decades of decline, what the decline is made of, and the sorting underneath it
          that a county total cannot show.
        </span>
      </li>
      <li>
        <a href="/work">Work</a>
        <span class="why">
          What happened to the factory county, what a job here pays, and the half of these
          jobs held by people who live somewhere else.
        </span>
      </li>
      <li>
        <a href="/government">Government</a>
        <span class="why">
          Nine offices, who chooses them, what they cost — and a county containing precincts
          ninety points apart.
        </span>
      </li>
      <li>
        <a href="/history">History</a>
        <span class="why">
          Everything this corpus can date, and the stretches between, which are the larger
          part of the record.
        </span>
      </li>
      <li>
        <a href="/read">The reading room</a>
        <span class="why">
          Thirty-seven shorter pieces — the fort across the line, ninety-nine papers, three
          times a crowd came to the jail.
        </span>
      </li>
      <li>
        <a href="/map">The map</a>
        <span class="why">
          The corpus's places on the county's actual 2020 boundaries, which is the only way to
          see a location claim that is wrong.
        </span>
      </li>
      <li>
        <a href="/sources">Sources</a>
        <span class="why">
          How much of this is sourced, how much is inferred, and what was withheld.
        </span>
      </li>
    </ul>
  </section>
  </div>

  <style>
    /* `.tiles`, `.section-lede` and `.onward` are in `styles/reading.css` now. */
    .opening {
      font-size: var(--size-body-l);
      margin-bottom: var(--space-12);
    }
  </style>
</Base>

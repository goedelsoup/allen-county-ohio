// Typed out because these are fund totals from a PDF, not properties the graph carries.
const funds = [
  ['The whole revenue report, 437 funds', '$374,841,547', '100%'],
  ['52 custodial funds numbered 9xxx', '$181,069,850', '48.3%'],
  ['— of which real estate tax collected for others', '$139,249,231', '37.1%'],
  ['The General Fund, which the county runs on', '$39,567,583', '10.6%'],
]

// Typed out because these are dates a newspaper printed, not term dates the graph carries.
// The point of the table is that the last column exists and the middle one does not.
const sampled = [
  ['1939-11-23', 'Frank McClain', 'cut twelve street-department men 48 hours after taking office'],
  ['1940-02-08', 'Frank E. McClain', 'called a civil service examination for chief of police'],
  ['1941-11-20', 'Frank McClain', 're-elected; election expenses of $306.40'],
  ['1942-06-04', 'Frank McClain', '48 more parking meters, bringing the city to 365'],
  ['1943-11-04', 'Frank E. McClain', 'appointed a chief of police'],
  ['1944-03-02', 'A. L. Metheany', 'council appropriated $10,000 for fire apparatus'],
  ['1944-08-31', 'Allen L. Metheany', '“late mayor of Lima”; estate inventoried at $42,797.51'],
  ['1945-05-10', 'William L. Ferguson', 'welcomed the manager of the Lima Reds'],
  ['1945-07-19', 'W. I. Ferguson', 'his fire bureau closed City Hall’s third floor to meetings'],

---
import Base from '../layouts/Base.astro'
import AssertionCard from '../components/AssertionCard.astro'
import ChartFigure from '../components/ChartFigure.astro'
import { assertion, seriesById } from '../lib/feeds'
import type { BarSpec, LineSpec } from '../scripts/charts'

const decline = assertion('county-population-decline')
const concentration = assertion('decline-concentrated-in-lima')
const breadth = assertion('decline-is-not-suburbanization')
const mechanism = assertion('decline-is-migration-and-deaths')
const century = assertion('lima-grew-fivefold-after-the-oil')
const peaks = assertion('three-peaks-thirty-years-apart')
const townships = assertion('every-township-grew')
const whole = assertion('the-county-has-a-complete-series')

// The county chart is the assertion's own figures: the seven numbers the corpus enumerated
// inside the sentence the assertion cites, checked against that sentence at build time.
const countySpec: LineSpec = {
  kind: 'line',
  x: decline.figures.map((f) => f.label),
  series: [{ name: 'Allen County', y: decline.figures.map((f) => f.value) }],
  yTitle: 'Residents',
  labelLast: true,
}

// The comparison chart indexes two measured series to a common base. Two measures of very
// different size on one axis would be a dual-axis chart, which invents a correlation; an
// index puts both on one honest scale.
const county = seriesById('place-allen-county::total-resident-population')
const lima = seriesById('place-lima::total-resident-population')

// One enumeration and one estimates base share the 2020 date in both series. The estimates
// line is the one that is comparable across all four dates, so the census figures are left
// to the table rather than mixed into a series with them.
const estimates = (points: typeof county.points) => points.filter((p) => !p.node.includes('-census'))

const countyEst = estimates(county.points).filter((p) => p.as_of >= '2000')
const limaEst = estimates(lima.points)
const dates = countyEst.map((p) => p.as_of.slice(0, 4))

const indexed = (points: typeof county.points) => {
  const base = points[0].value
  return points.map((p) => Math.round((p.value / base) * 1000) / 10)
}

const indexSpec: LineSpec = {
  kind: 'line',
  x: dates,
  series: [
    { name: 'Allen County', y: indexed(countyEst) },
    { name: 'Lima', y: indexed(limaEst) },
  ],
  yTitle: '2000 = 100',
  labelLast: true,
}

const rateSpec: BarSpec = {
  kind: 'bar',
  categories: concentration.figures.map((f) => f.label),
  values: concentration.figures.map((f) => f.value),
  yTitle: 'Per cent lost, 2000–2010',
  tickSuffix: '%',
  labelValues: true,
}

// Two negative components on one axis. A bar chart is right here and a pie chart would not
// be: these are two independent forces that happen to point the same way, not shares of a
// whole, and the residual of 28 the corpus names belongs to neither.
const mechanismSpec: BarSpec = {
  kind: 'bar',
  categories: mechanism.figures.map((f) => f.label),
  values: mechanism.figures.map((f) => f.value),
  yTitle: 'People, four years to 2024',
  labelValues: true,
}

// Eight counts at uneven spacing — twenty years to 1920, ten thereafter. Still a bar chart
// rather than a line: a line drawn across categories of unequal width states a rate the
// spacing does not support, and the 1880-to-1900 step is twice the others.
const centurySpec: BarSpec = {
  kind: 'bar',
  categories: century.figures.map((f) => f.label),
  values: century.figures.map((f) => f.value),
  yTitle: 'Residents of Lima',
  labelValues: true,
}

// Nine decennial counts a decade apart, so a line is right here where it was wrong above:
// the spacing is even and every point is an enumeration rather than an estimate.
const peaksSpec: LineSpec = {
  kind: 'line',
  x: peaks.figures.map((f) => f.label),
  series: [{ name: 'Allen County outside Lima', y: peaks.figures.map((f) => f.value) }],
  yTitle: 'Residents',
  labelLast: true,
}

// Twenty-one points a decade apart. A line, and the only chart here that spans the whole
// record — labelLast would put the number on 2020, which is not the point of it.
const wholeSpec: LineSpec = {
  kind: 'line',
  x: whole.figures.map((f) => f.label),
  series: [{ name: 'Allen County', y: whole.figures.map((f) => f.value) }],
  yTitle: 'Residents',
}

const allPoints = [...county.points, ...lima.points].toSorted((a, b) =>
  a.as_of === b.as_of ? a.node.localeCompare(b.node) : a.as_of.localeCompare(b.as_of),
)
---

<Base
  title="Population"
  lede="Allen County peaked in 1980 and has fallen at every count since. What that does and does not show is the whole of this page."
>
  <AssertionCard assertion={decline} open />

  <section>
    <h2>The whole record</h2>
    <p>
      The county has been counted every ten years since 1830 and this corpus now holds all
      twenty-one counts. It grew at every census for a hundred and fifty years, peaked in 1980, and
      has fallen at every census since — it is smaller today than it was in 1960. The first two
      figures count different ground: the reorganization of 1848 moved 138 square miles.
    </p>
    <AssertionCard assertion={whole} />

    <ChartFigure
      id="whole"
      title="Allen County, 1830–2020"
      caption="Every decennial census. Assembled from three county histories and four Census publications; the 1850 figure is contested, with the 1885 history giving 12,100 and the 1906 one 12,116."
      columns={['Census', 'Residents']}
      rows={whole.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
    />
    <script type="application/json" data-chart-spec="whole" set:html={JSON.stringify(wholeSpec)} is:inline />
  </section>

  <ChartFigure
    id="county-population"
    title="Allen County, 1970–2024"
    caption="The five figures the corpus enumerates in the passage above. A count and an estimate are different instruments; the table below names which each figure is."
    columns={['Figure', 'Residents']}
    rows={decline.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
  />

  <script type="application/json" data-chart-spec="county-population" set:html={JSON.stringify(countySpec)} is:inline />

  <section>
    <h2>The loss is not spread evenly</h2>
    <AssertionCard assertion={concentration} />

    <ChartFigure
      id="decline-rate"
      title="Rate of loss, 2000–2010"
      caption="Lima against everything in the county outside every incorporated place."
      columns={['Where', 'Per cent lost']}
      rows={concentration.figures.map((f) => [f.label, `${f.value}%`])}
      height={280}
    />
    <script type="application/json" data-chart-spec="decline-rate" set:html={JSON.stringify(rateSpec)} is:inline />

    <ChartFigure
      id="indexed"
      title="City and county, indexed to 2000"
      caption="Both series set to 100 at 2000, so two populations three times apart in size can share one axis. Estimates only — the decennial counts are in the table and are a different instrument. The indexing is arithmetic done on this page; every input is a Census figure from the corpus."
      columns={['Date', 'Subject', 'Figure', 'Basis']}
      rows={allPoints.map((p) => [
        p.as_of,
        p.node.startsWith('measure/lima') ? 'Lima' : 'Allen County',
        p.value.toLocaleString('en-US'),
        p.node.includes('-census') ? 'Decennial count' : 'Estimate',
      ])}
    />
    <script type="application/json" data-chart-spec="indexed" set:html={JSON.stringify(indexSpec)} is:inline />
  </section>

  <section>
    <h2>And it is not suburbanization</h2>
    <AssertionCard assertion={breadth} />
  </section>

  <section>
    <h2>Why it shrinks</h2>
    <p>
      Five decades of this page described a decline without explaining it. The Population
      Estimates programme publishes the components of change — births, deaths, and migration
      split into domestic and international — and the corpus had held that file, uncited on
      these columns, since its second phase.
    </p>
    <AssertionCard assertion={mechanism} />

    <ChartFigure
      id="mechanism"
      title="What the loss is made of, 2021–2024"
      caption="The two forces are independent and both negative; a residual of 28 belongs to neither. Migration is the larger, and within it a domestic loss of 1,217 is partly offset by an international gain of 424."
      columns={['Component', 'People']}
      rows={mechanism.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="mechanism" set:html={JSON.stringify(mechanismSpec)} is:inline />
  </section>

  <section>
    <h2>Before the series begins</h2>
    <p>
      Everything above begins in 1970, because 1970 was the earliest figure this corpus held. The
      city tripled in the twenty years after the 1885 oil strike and doubled again by 1920,
      reaching 41,326 people, and went on rising at every census to 53,734 in 1970. It is 35,579
      today. Every count before 1970 is higher than the one before it and every count after is
      lower, so 1970 is the peak and not merely the earliest thing on the page.
    </p>
    <AssertionCard assertion={century} />

    <ChartFigure
      id="century"
      title="Lima, 1880 to 1970"
      caption="From the Census Bureau's 1960 volume, which carries each place back to its earliest census. Three county histories supplied the 1880, 1900 and 1920 figures first; the Census confirms the first two to the person and corrects the third from 41,306 to 41,326. The steps are twenty years to 1920 and ten after it, which is why these are bars and not a line."
      columns={['Census', 'Residents']}
      rows={century.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="century" set:html={JSON.stringify(centurySpec)} is:inline />
  </section>

  <section>
    <h2>Three peaks, thirty years apart</h2>
    <p>
      A line labelled "Allen County" hides the thing this page is actually about. Take Lima out of
      the county and what is left grew at every census from 1940 to 2000 — from 28,592 people to
      68,157 — and has fallen at both censuses since. So the city turned in 1970, the county in
      1980, and the county outside the city in 2000. For thirty of those years the county was
      shrinking while two thirds of it grew. That is not in tension with the section above: the
      ring has been falling since 2000, and the four recent years measured there sit inside the
      falling part of a curve that rose for sixty.
    </p>
    <AssertionCard assertion={peaks} />

    <ChartFigure
      id="peaks"
      title="Allen County outside Lima, 1940–2020"
      caption="Subtraction, not a published figure: the city's count taken from the county's at each census, both from Census publications. The one fall before 2000 is 208 people in the 1980s, and the 1980s are the one decade in which Lima is known to have annexed — which moves people out of this series without anyone moving house."
      columns={['Census', 'Residents outside Lima']}
      rows={peaks.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
    />
    <script type="application/json" data-chart-spec="peaks" set:html={JSON.stringify(peaksSpec)} is:inline />

    <p>
      The same thing said one grain down. The county's twelve townships are now on record for 1930,
      1940 and 1950, and every one of them holds more people today than it did in 1930 — from Sugar
      Creek, a fifth larger, to Shawnee, six times over. Shawnee and American are the two that
      border Lima on its south and west.
    </p>
    <AssertionCard assertion={townships} />
  </section>

  <script>
    import { renderCharts } from '../scripts/charts'
    renderCharts()
  </script>

  <style>
    section {
      margin-top: 3rem;
    }
  </style>
</Base>

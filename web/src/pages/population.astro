---
import Base from '../layouts/Base.astro'
import AssertionCard from '../components/AssertionCard.astro'
import ChartFigure from '../components/ChartFigure.astro'
import DataTable from '../components/DataTable.astro'
import { assertion, seriesById } from '../lib/feeds'
import { bar, line } from '../lib/chart-spec'

const decline = assertion('county-population-decline')
const concentration = assertion('decline-concentrated-in-lima')
const breadth = assertion('decline-is-not-suburbanization')
const mechanism = assertion('decline-is-migration-and-deaths')
const century = assertion('lima-grew-fivefold-after-the-oil')
const peaks = assertion('three-peaks-thirty-years-apart')
const townships = assertion('every-township-grew')
const whole = assertion('the-county-has-a-complete-series')
const work = assertion('the-only-employment-figures')
const factories = assertion('the-factories-stopped-leaving')
const farms = assertion('the-farms-did-not-go-anywhere')
const health = assertion('health-care-fell-too')
const hospitals = assertion('five-hospitals-one-locally-owned')
const refinery = assertion('the-refinery-outgrew-them')
const outside = assertion('the-plants-are-outside-every-city')
const concentration2 = assertion('what-the-concentration-is-made-of')
const young = assertion('lima-is-the-young-end')
const counted1920 = assertion('the-census-counted-what-the-history-estimated')
const forties = assertion('the-migration-arrived-in-the-forties')
const stopped = assertion('the-workforce-stopped-growing-in-1914')

// Lima's factory workforce at six censuses. From the assertion's own figures, so the chart cannot
// drift from the prose the gate checked.
const stoppedSpec = line(
  stopped.figures.map((f) => f.label),
  [{ name: 'Manufacturing wage earners, Lima', y: stopped.figures.map((f) => f.value) }],
  { yTitle: 'Manufacturing wage earners, city of Lima', zeroBased: true, labelLast: true },
)

// The county and the city in 1929, and the difference between them. Typed out because the third
// column is computed and the graph carries only the two the volume prints.
const manufactures1929 = [
  ['Establishments', '108', '72', '36'],
  ['Wage earners', '6,588', '4,548', '2,040'],
  ['Horsepower', '21,717', '13,030', '8,687'],
  ['Wages', '$8,337,261', '$5,666,171', '$2,671,090'],
  ['Value of products', '$47,139,403', '$29,595,853', '$17,543,550'],
  ['Value added', '$18,544,201', '$13,391,977', '$5,152,224'],
]

const bornSpec = bar(
  counted1920.figures.map((f) => f.label),
  counted1920.figures.map((f) => f.value),
  { yTitle: 'Foreign-born residents of Allen County, 1920, by country of birth', labelValues: true },
)

// The county's Black population at five censuses. Drawn from the assertion's own figures so the
// chart cannot drift from the prose the gate checked.
const migrationSpec = line(
  forties.figures.map((f) => f.label),
  [{ name: 'Black residents of Allen County', y: forties.figures.map((f) => f.value) }],
  { yTitle: 'Persons enumerated as Negro, Allen County', zeroBased: true, labelLast: true },
)

// The four censuses read this phase, with 1920 and 2023 for the ends. Typed out because the six
// rows come from six publications and the graph carries them as six measures.
const raceSeries = [
  ['1920', '68,223', '1,385', '2.03%', '2,753'],
  ['1930', '69,419', '1,686', '2.43%', '2,219'],
  ['1940', '73,303', '1,916', '2.61%', '1,682'],
  ['1950', '88,183', '4,391', '4.98%', '1,485'],
  ['1960', '103,691', '7,322', '7.06%', '—'],
  ['2023', '101,685', '10,805', '10.6%', '—'],
]

// The 1920 composition of the county and the city, side by side. Typed out because the two halves
// come from two tables of the same census and the graph carries them as one measure.
const composition1920 = [
  ['Total population', '68,223', '41,326'],
  ['Native white', '64,064', '40,062 (all white)'],
  ['— of native parentage', '55,543', '32,572'],
  ['— of foreign parentage', '4,422', '3,080'],
  ['— of mixed parentage', '4,099', '2,493'],
  ['Foreign-born white', '2,753', '1,917'],
  ['Negro', '1,385', '1,243'],
  ['Other', '21', '—'],
]

// The county chart is the assertion's own figures: the seven numbers the corpus enumerated
// inside the sentence the assertion cites, checked against that sentence at build time.
const countySpec = line(decline.figures.map((f) => f.label), [{ name: 'Allen County', y: decline.figures.map((f) => f.value) }], {
  yTitle: 'Residents',
  labelLast: true,
})

// The comparison chart indexes two measured series to a common base. Two measures of very
// different size on one axis would be a dual-axis chart, which invents a correlation; an
// index puts both on one honest scale.
const county = seriesById('place-allen-county::total-resident-population')
const lima = seriesById('place-lima::total-resident-population')

// One enumeration and one estimates base share the 2020 date in both series. The estimates
// line is the one that is comparable across all four dates, so the census figures are left
// to the table rather than mixed into a series with them.
const estimates = (points: typeof county.points) => points.filter((p) => !p.node.includes('-census'))

const countyEst = estimates(county.points).filter((p) => p.as_of >= '2000')
const limaEst = estimates(lima.points)
const dates = countyEst.map((p) => p.as_of.slice(0, 4))

const indexed = (points: typeof county.points) => {
  const base = points[0].value
  return points.map((p) => Math.round((p.value / base) * 1000) / 10)
}

const indexSpec = line(dates, [
    { name: 'Allen County', y: indexed(countyEst) },
    { name: 'Lima', y: indexed(limaEst) },
  ], {
  yTitle: '2000 = 100',
  labelLast: true,
})

const rateSpec = bar(concentration.figures.map((f) => f.label), concentration.figures.map((f) => f.value), {
  yTitle: 'Per cent lost, 2000–2010',
  tickSuffix: '%',
  labelValues: true,
})

// Two negative components on one axis. A bar chart is right here and a pie chart would not
// be: these are two independent forces that happen to point the same way, not shares of a
// whole, and the residual of 28 the corpus names belongs to neither.
const mechanismSpec = bar(mechanism.figures.map((f) => f.label), mechanism.figures.map((f) => f.value), {
  yTitle: 'People, four years to 2024',
  labelValues: true,
})

// Eight counts at uneven spacing — twenty years to 1920, ten thereafter. Still a bar chart
// rather than a line: a line drawn across categories of unequal width states a rate the
// spacing does not support, and the 1880-to-1900 step is twice the others.
const centurySpec = bar(century.figures.map((f) => f.label), century.figures.map((f) => f.value), {
  yTitle: 'Residents of Lima',
  labelValues: true,
})

// Nine decennial counts a decade apart, so a line is right here where it was wrong above:
// the spacing is even and every point is an enumeration rather than an estimate.
const peaksSpec = line(peaks.figures.map((f) => f.label), [{ name: 'Allen County outside Lima', y: peaks.figures.map((f) => f.value) }], {
  yTitle: 'Residents',
  labelLast: true,
})

// Twenty-one points a decade apart. A line, and the only chart here that spans the whole
// record — labelLast would put the number on 2020, which is not the point of it.
const wholeSpec = line(whole.figures.map((f) => f.label), [{ name: 'Allen County', y: whole.figures.map((f) => f.value) }], {
  yTitle: 'Residents',
})

// Three points five years apart, which is why they are bars: the gaps are not decades and a
// line across them would imply a path through 1902 that nobody counted.
// Four components of one subtraction, so a bar chart and not a line: these are the pieces of
// a single twelve-year loss, not a series through time. They sum to 2,593, which is the whole
// of it — the four subsectors close against the sector total in every one of the thirteen years.
const healthSpec = bar(health.figures.map((f) => f.label), health.figures.map((f) => f.value), {
  yTitle: 'Jobs lost, 2010–2022',
  labelValues: true,
})

// Four points at uneven spacing across thirty-one reports, so a bar chart rather than a line:
// the gaps between them are nine, four and nineteen years, and a line drawn across those states
// a rate the spacing does not support. 1996 and 1998 are not published at all.
const refinerySpec = bar(refinery.figures.map((f) => f.label), refinery.figures.map((f) => f.value), {
  yTitle: 'Barrels of crude per calendar day',
  labelValues: true,
})

// One city measured three ways against the same denominator, so the bars are comparable and
// the reading is the distance between them. They are not shares of a whole and a pie would say
// they were.
const concentrationSpec = bar(concentration2.figures.map((f) => f.label), concentration2.figures.map((f) => f.value), {
  yTitle: "Lima's share of the county",
  tickSuffix: '%',
  labelValues: true,
})

const workSpec = bar(work.figures.map((f) => f.label), work.figures.map((f) => f.value), {
  yTitle: 'Manufacturing wage earners, Lima',
  labelValues: true,
})

// Two bars that are nearly the same height. That is the finding, and a line between two points
// would draw a trend across a gap that holds no observations.
const farmSpec = bar(farms.figures.map((f) => f.label), farms.figures.map((f) => f.value), {
  yTitle: 'Acres of land in farms, Allen County',
  labelValues: true,
})

// Three points across thirty-six years, so bars rather than a line: the corpus read nine files
// and this chart shows the two ends and the floor between them.
const factorySpec = bar(factories.figures.map((f) => f.label), factories.figures.map((f) => f.value), {
  yTitle: 'Manufacturing employment, Allen County',
  labelValues: true,
})

const allPoints = [...county.points, ...lima.points].toSorted((a, b) =>
  a.as_of === b.as_of ? a.node.localeCompare(b.node) : a.as_of.localeCompare(b.as_of),
)
---

<Base
  title="Population"
  lede="Allen County peaked in 1980 and has fallen at every count since. What that does and does not show is the whole of this page."
>
  <AssertionCard assertion={decline} open />

  <section>
    <h2>The whole record</h2>
    <p>
      The county has been counted every ten years since 1830 and this corpus now holds all
      twenty-one counts. It grew at every census for a hundred and fifty years, peaked in 1980, and
      has fallen at every census since — it is smaller today than it was in 1960. The first two
      figures count different ground: the reorganization of 1848 moved 138 square miles.
    </p>
    <AssertionCard assertion={whole} />

    <ChartFigure
      id="whole"
      title="Allen County, 1830–2020"
      caption="Every decennial census. Assembled from three county histories and four Census publications; the 1850 figure is contested, with the 1885 history giving 12,100 and the 1906 one 12,116."
      columns={['Census', 'Residents']}
      rows={whole.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
    />
    <script type="application/json" data-chart-spec="whole" set:html={JSON.stringify(wholeSpec)} is:inline />
  </section>

  <ChartFigure
    id="county-population"
    title="Allen County, 1970–2024"
    caption="The five figures the corpus enumerates in the passage above. A count and an estimate are different instruments; the table below names which each figure is."
    columns={['Figure', 'Residents']}
    rows={decline.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
  />

  <script type="application/json" data-chart-spec="county-population" set:html={JSON.stringify(countySpec)} is:inline />

  <section>
    <h2>The loss is not spread evenly</h2>
    <AssertionCard assertion={concentration} />

    <ChartFigure
      id="decline-rate"
      title="Rate of loss, 2000–2010"
      caption="Lima against everything in the county outside every incorporated place."
      columns={['Where', 'Per cent lost']}
      rows={concentration.figures.map((f) => [f.label, `${f.value}%`])}
      height={280}
    />
    <script type="application/json" data-chart-spec="decline-rate" set:html={JSON.stringify(rateSpec)} is:inline />

    <ChartFigure
      id="indexed"
      title="City and county, indexed to 2000"
      caption="Both series set to 100 at 2000, so two populations three times apart in size can share one axis. Estimates only — the decennial counts are in the table and are a different instrument. The indexing is arithmetic done on this page; every input is a Census figure from the corpus."
      columns={['Date', 'Subject', 'Figure', 'Basis']}
      rows={allPoints.map((p) => [
        p.as_of,
        p.node.startsWith('measure/lima') ? 'Lima' : 'Allen County',
        p.value.toLocaleString('en-US'),
        p.node.includes('-census') ? 'Decennial count' : 'Estimate',
      ])}
    />
    <script type="application/json" data-chart-spec="indexed" set:html={JSON.stringify(indexSpec)} is:inline />
  </section>

  <section>
    <h2>What the concentration is made of</h2>
    <p>
      This page has said for ten versions that the county's loss is concentrated in Lima, and until
      now it could not say what Lima is. It is a third of the county's people, two thirds of its
      poor, and three quarters of its Black residents — and the three shares close exactly against
      the county's own rows, so this is one city measured three ways rather than three estimates.
    </p>
    <AssertionCard assertion={concentration2} open />

    <ChartFigure
      id="concentration2"
      title="Lima's share of Allen County, 2023"
      caption="American Community Survey, 2023 five-year estimates. Ohio's twelve townships and Lima partition the county, and the three sums — 101,685 people, 12,815 below poverty, 10,805 Black residents — are the county's own figures. The bars are three measures of one city against one denominator, not parts of a whole."
      columns={['Measure', "Lima's share"]}
      rows={concentration2.figures.map((f) => [f.label, `${f.value}%`])}
      height={260}
    />
    <script type="application/json" data-chart-spec="concentration2" set:html={JSON.stringify(concentrationSpec)} is:inline />

    <p>
      Lima's median household income is <strong>$43,370</strong>, against $91,134 in Shawnee Township
      across its southern line — forty-eight per cent — and fifty-five per cent of the national
      figure. Outside the city and the two townships that touch it, the county runs between ninety
      and ninety-seven per cent white; eight of the twelve townships have fewer than a hundred Black
      residents, and two report none.
    </p>
    <p>
      What this describes is a county as it now stands. It does not date the sorting, and nothing
      retrieved here says whether it is the residue of a process the decline covers or one that
      finished before the decline began.
    </p>
    <p>
      This is also the first source on this page that publishes how wrong it might be. Every figure
      in it carries a margin — Amanda Township's median household income is $99,148 give or take
      $20,903 — and the first claim written from it was one the margins refused. Lima has the lowest
      household income figure in the county and cannot be said to have the lowest household income:
      Perry Township's is higher by $9,902 against a combined margin of $11,142. The gap that does
      survive is the one against Shawnee, which is seven and a half times its margin.
    </p>
  </section>

  <section>
    <h2>But not because it is old</h2>
    <AssertionCard assertion={young} open />
    <p>
      Two things this page already says compose into a story that is not true. It says the county
      loses people partly to natural decrease — more deaths than births — and it says the loss is
      concentrated in Lima. Put together, those describe a city dying of age.
    </p>
    <p>
      Lima's median age is 35.4 against the county's 39.7. Its share over sixty-five is 15.6 per cent
      against 18.7, and its share under eighteen is higher than the county's. Eleven of the twelve
      townships are older than the city. Perry Township is 27.9 per cent over sixty-five; Lima is the
      young end of this county and the townships are the old one, and whatever natural decrease the
      county has is not principally the city's.
    </p>
  </section>

  <section>
    <h2>And it is not suburbanization</h2>
    <AssertionCard assertion={breadth} />
  </section>

  <section>
    <h2>Where the industrial city started</h2>
    <p>
      This period is named for manufacturing, and for eleven phases every figure on this page was
      population. The corpus holds three counts from before 1910: Lima had 1,980 manufacturing wage
      earners in 1899, 2,733 in 1904 and 3,607 in 1909, in 85 establishments, of whom thirty per
      cent were women and fifty-one were under sixteen. Its leading industries were tobacco and
      locomotives. That is the industrial city sixty years before the decline this page describes —
      a baseline, and not an explanation.
    </p>
    <AssertionCard assertion={work} />

    <ChartFigure
      id="work"
      title="Lima manufacturing wage earners, 1899–1909"
      caption="Census of Manufactures. Establishments inside the city limits only, which the volume states in a footnote — and the county's largest industrial installation, the refinery, is outside the city line today. Between 1899 and 1904 the workforce grew 38 per cent while the value of what it made fell 22."
      columns={['Census year', 'Wage earners']}
      rows={work.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="work" set:html={JSON.stringify(workSpec)} is:inline />
    <AssertionCard assertion={stopped} />
    <p>
      Three more censuses have since been read, from the Ohio state volume of each, and they change
      the shape of that baseline. Lima's factory workforce grew by 146 per cent in the fifteen years
      to 1914 — and then by twenty-five people in the five years after it, a span that contains a
      world war. By 1929 it was 4,548, three hundred and twenty-eight below the 1914 figure. The
      growth had stopped fifteen years before the Depression and forty before the decline this page
      is named for.
    </p>
    <ChartFigure
      id="lima-workforce-1899-1929"
      title="Lima manufacturing wage earners, 1899–1929"
      caption="The count of establishments falls from 108 in 1919 to 72 in 1929, and about half of that is the Bureau raising its minimum from $500 of product to $5,000 — a change it measured at a 21.6 per cent reduction nationally. Wage earners are unaffected: 99.4 per cent of them worked in establishments above the higher line."
      columns={['Census year', 'Wage earners']}
      rows={stopped.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={300}
    />
    <script type="application/json" data-chart-spec="lima-workforce-1899-1929" set:html={JSON.stringify(stoppedSpec)} is:inline />
    <p>
      The 1929 volume is also the first that reports Allen County at all, which lets the city be set
      against the county around it for the first time before 1969.
    </p>
    <DataTable
      title="Manufacturing in Allen County and Lima, 1929"
      caption="The first two columns are the volume's; the third is the difference. The 2,040 wage earners outside the city line averaged $1,309 in wages against $1,246 inside it, and added $2,526 of value each against $2,944 — the shape of processing rather than assembly, in a county whose refinery stands outside every municipality."
      columns={['', 'Allen County', 'Lima', 'Outside Lima']}
      rows={manufactures1929}
    />
    <p>
      And the county's 6,588 wage earners in 1929 are fewer than the 8,715 manufacturing jobs it
      recorded in 2022 — even after allowing for the salaried officers and clerks the census
      excluded and the modern series counts. Whatever this county's industrial century was, its top
      is inside the forty years between 1929 and 1969 that no volume covers.
    </p>
  </section>

  <section>
    <h2>And what happened to it</h2>
    <p>
      The Bureau of Economic Analysis has counted this county's jobs by industry every year since
      1969, and the decline this page is named for is in it, whole:
      <strong>manufacturing employment peaked at 18,400 in 1973 and bottomed at 7,775 in 2009</strong>.
      Fifty-eight per cent of it, over thirty-six years.
    </p>
    <p>
      The peak is three years <em>after</em> Lima's population peak, and the county's factories were
      still within eleven jobs of that peak in 1979. Whatever emptied the city, it had started
      before the manufacturing decline that is supposed to explain it.
    </p>
    <AssertionCard assertion={factories} />

    <ChartFigure
      id="factories"
      title="Manufacturing employment, Allen County, 1973–2022"
      caption="BEA Regional Economic Accounts, all jobs including proprietors and government. The 1982 and 1986 points are here on purpose: 1982 is a recession trough and 1986 a recovery high, and an earlier version of this chart began at 1986 and read it as a stage of the fall. County Business Patterns, a separate programme counting private employees only, gives a lower level and the same shape."
      columns={['Year', 'Manufacturing jobs']}
      rows={factories.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="factories" set:html={JSON.stringify(factorySpec)} is:inline />

    <p>
      Then it stopped. Manufacturing bottomed in 2009 and has risen since, to 8,715 in 2022 — while
      the county went on losing people. On the separate County Business Patterns count, private
      employment fell by 3,709 between 2010 and 2022 while manufacturing rose by 1,446, so every net
      job lost in those twelve years was lost somewhere else. The largest single loss was health
      care, down 2,593 to 9,151, and health care is now the county's biggest private employer
      sector — and falling, which the next section is about.
    </p>
    <p>
      And for thirty-one years before any of that, the county's jobs went <em>up</em>. Total
      employment rose from 56,562 in 1969 to 72,973 in 2000 — twenty-nine per cent — through the
      whole of the period this page calls decline, and peaked twenty years after the population did.
      Whatever Allen County lost between 1980 and 2000, it was not work.
    </p>
    <p>
      Which is why the caveat under the chart at the top of this page changed rather than
      disappearing. It used to say the corpus had not measured the cause. It now says the corpus
      does not establish that the population decline was caused by the manufacturing decline — and
      it says so from a stronger position, because for the last twelve years the proposed cause
      moves opposite to the effect.
    </p>
    <p>
      The corpus used to hold one period for all of this, called <em>deindustrialization</em> and
      dated from roughly 1970. It now holds two, because these are two processes and they do not
      share a span. Deindustrialization runs 1979 to 2009 and has ended. Depopulation runs from
      1970 and has not. The old start date was read off the population series and written on a node
      named for industry, which nothing could contradict until the industry was counted.
    </p>
  </section>

  <section>
    <h2>What replaced it is falling too</h2>
    <p>
      Health care overtook manufacturing to become Allen County's largest private employer sector,
      and it did not hold. It <strong>peaked at 12,431 in 2013</strong> and stood at 9,151 in 2022 —
      a bigger fall, in nine years, than manufacturing managed in the twelve before it.
    </p>
    <p>
      This page said something weaker and wronger until now. It said health care had fallen from
      11,744 in 2010, because the corpus had read County Business Patterns at five-year steps and
      2013 was not one of the steps. The levels were right and the shape was not, and a sample can
      only ever report the first. The nine missing files were in the same directory as the four that
      were taken.
    </p>
    <AssertionCard assertion={health} />

    <ChartFigure
      id="health"
      title="Where Allen County's health care jobs went, 2010–2022"
      caption="County Business Patterns, NAICS 62 and its four subsectors. The four sum to 2,593, which is the sector's whole loss against 2010 — they close against the sector total exactly in all thirteen years, so nothing here is suppressed or unaccounted. Measured from the 2013 peak instead, the sector lost 3,280 and ambulatory care rather than hospitals is the largest single piece; the corpus carries every baseline rather than the one that reads best."
      columns={['Subsector', 'Jobs lost']}
      rows={health.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="health" set:html={JSON.stringify(healthSpec)} is:inline />

    <p>
      Which is as far as the numbers go. The corpus can now say <em>what</em> contracted and still
      holds nothing that says why, and 2020 sits inside the window with its effect on the 2022
      reading unseparated.
    </p>
  </section>

  <section>
    <h2>Who the employers are</h2>
    <p>
      For eight phases this corpus measured a county's work and never named an employer. It now
      names five, in the sector that employs the most people here — and the useful fact about them
      is not their size.
    </p>
    <AssertionCard assertion={hospitals} />
    <p>
      Every one of the five trades under a name that is not the name of the body that enrolls with
      Medicare. Two are unrecognisable from the sign: the orthopaedic hospital enrolls as West
      Central Ohio Group Ltd., and Bluffton Hospital as Blanchard Valley Regional Health Center — a
      name belonging to a valley in the next county, which is also where its owner is.
    </p>
    <p>
      Two of them stand at the same address, 730 West Market Street, so the county's five hospitals
      occupy four buildings. And one of them is not in Lima at all: the Institute for Orthopaedic
      Surgery has a Lima postal address and sits in Perry Township, outside any municipality, as the
      refinery and the tank plant do. That was checked before it was written rather than after,
      which is the fourth time this corpus has had to ask the question and the first time it asked
      it in advance.
    </p>
  </section>

  <section>
    <h2>And the one that grew</h2>
    <p>
      Every other chart on this page counts people. This one counts what the county can make, and it
      goes the other way. The refinery Standard Oil put on a Shawnee Township farm in 1886 could run
      <strong>145,000 barrels of crude a day in 1994 and can run 183,000 now</strong> — up a quarter,
      across the same decades in which the county's manufacturing employment fell by more than half.
    </p>
    <AssertionCard assertion={refinery} />

    <ChartFigure
      id="refinery"
      title="Lima refinery crude capacity, 1994–2026"
      caption="EIA Refinery Capacity Report, atmospheric crude distillation in barrels per calendar day, as of 1 January of each report year. Four of thirty-one reports are shown; 1996 and 1998 are not published. The 2007 trough is the last year the works filed as Premcor, and every year since is higher."
      columns={['Report year', 'Barrels per calendar day']}
      rows={refinery.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="refinery" set:html={JSON.stringify(refinerySpec)} is:inline />

    <p>
      A county's output and a county's payroll are not the same quantity, and this is the clearest
      case of it here. The refinery is the largest in Ohio and thirty-sixth of the hundred and
      twenty-four in the country, and nothing on this page says how many people work in it — because
      no source the corpus holds does.
    </p>
    <p>
      Who operates it was an open question in this corpus from its first day. It is BP through the
      1997 report, Clark Refining, then Premcor, then the Lima Refining Company from 2008 — under
      Husky Energy from 2010 and Cenovus since 2022. The hundred and eight years between the Solar
      Refining Company in 1886 and BP in 1994 are still unsourced, and the federal census cannot
      supply them: its corporate-parent column does not exist before 2010.
    </p>
    <p>
      Meanwhile Allen County's own address file still labels the site <em>Valero Lima Refinery</em>,
      and the federal census never prints the word Valero in any year of any report. Two authorities,
      two companies, one set of works, and neither name carries a date.
    </p>
  </section>

  <section>
    <h2>None of them is in a city</h2>
    <AssertionCard assertion={outside} open />
    <p>
      The refinery and the tank plant stand in Shawnee Township; the Ford engine plant stands in
      Bath. All three have Lima postal addresses and none of them is in Lima, or in any other
      municipality. That is a fact about who may levy on the county's industrial base before it is a
      fact about geography.
    </p>
    <p>
      The corpus asserted the opposite about the refinery and the tank plant from its first day, on
      the strength of their addresses and their names. It has now had to check five times, and the
      last two — the Institute for Orthopaedic Surgery and this engine plant — were checked before
      the claim was written rather than after. One of those two was in Lima. The other was not.
    </p>
  </section>

  <section>
    <h2>And the thing it was supposed to have replaced</h2>
    <p>
      For nine phases this corpus described Allen County as a farming county reoriented by oil into
      an industrial one, and in all that time it had not measured a single farm. The same 1910 volume
      that counts Lima's factory workers counts the county's farms, and they had not gone anywhere:
      2,939 of them in 1910 against 2,858 in 1900, covering 240,472 of the county's 259,840 acres.
      More farms than before the boom, on two per cent less land, with more of that land improved.
    </p>
    <p>
      What the oil years did to farming here shows up in one figure only, and it is a price. An acre
      of Allen County farmland went from $38.39 in 1900 to $76.28 in 1910, and the county's farm
      property rose 89.0 per cent against 58.7 per cent for Ohio as a whole. Whether that was oil
      money bidding up the land is the obvious reading, and the corpus has nothing that would
      separate it from the general rise in Midwestern land values over the same decade.
    </p>
    <AssertionCard assertion={farms} />

    <ChartFigure
      id="farms"
      title="Land in farms, Allen County, 1900 and 1910"
      caption="Thirteenth Census of Agriculture. The county was already more than half city by population in 1910 — Lima held 30,508 of 56,580 — while still being nine-tenths farm by ground. This is the only agricultural census the corpus has read, so nothing here shows when the farmland began to go."
      columns={['Census year', 'Acres in farms']}
      rows={farms.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="farms" set:html={JSON.stringify(farmSpec)} is:inline />
  </section>

  <section>
    <h2>Why it shrinks</h2>
    <p>
      Five decades of this page described a decline without explaining it. The Population
      Estimates programme publishes the components of change — births, deaths, and migration
      split into domestic and international — and the corpus had held that file, uncited on
      these columns, since its second phase.
    </p>
    <AssertionCard assertion={mechanism} />

    <ChartFigure
      id="mechanism"
      title="What the loss is made of, 2021–2024"
      caption="The two forces are independent and both negative; a residual of 28 belongs to neither. Migration is the larger, and within it a domestic loss of 1,217 is partly offset by an international gain of 424."
      columns={['Component', 'People']}
      rows={mechanism.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="mechanism" set:html={JSON.stringify(mechanismSpec)} is:inline />
  </section>

  <section>
    <h2>Before the series begins</h2>
    <p>
      Everything above begins in 1970, because 1970 was the earliest figure this corpus held. The
      city tripled in the twenty years after the 1885 oil strike and doubled again by 1920,
      reaching 41,326 people, and went on rising at every census to 53,734 in 1970. It is 35,579
      today. Every count before 1970 is higher than the one before it and every count after is
      lower, so 1970 is the peak and not merely the earliest thing on the page.
    </p>
    <AssertionCard assertion={century} />

    <ChartFigure
      id="century"
      title="Lima, 1880 to 1970"
      caption="From the Census Bureau's 1960 volume, which carries each place back to its earliest census. Three county histories supplied the 1880, 1900 and 1920 figures first; the Census confirms the first two to the person and corrects the third from 41,306 to 41,326. The steps are twenty years to 1920 and ten after it, which is why these are bars and not a line."
      columns={['Census', 'Residents']}
      rows={century.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
      height={280}
    />
    <script type="application/json" data-chart-spec="century" set:html={JSON.stringify(centurySpec)} is:inline />
  </section>

  <section>
    <h2>Three peaks, thirty years apart</h2>
    <p>
      A line labelled "Allen County" hides the thing this page is actually about. Take Lima out of
      the county and what is left grew at every census from 1940 to 2000 — from 28,592 people to
      68,157 — and has fallen at both censuses since. So the city turned in 1970, the county in
      1980, and the county outside the city in 2000. For thirty of those years the county was
      shrinking while two thirds of it grew. That is not in tension with the section above: the
      ring has been falling since 2000, and the four recent years measured there sit inside the
      falling part of a curve that rose for sixty.
    </p>
    <AssertionCard assertion={peaks} />

    <ChartFigure
      id="peaks"
      title="Allen County outside Lima, 1940–2020"
      caption="Subtraction, not a published figure: the city's count taken from the county's at each census, both from Census publications. The one fall before 2000 is 208 people in the 1980s, and the 1980s are the one decade in which Lima is known to have annexed — which moves people out of this series without anyone moving house."
      columns={['Census', 'Residents outside Lima']}
      rows={peaks.figures.map((f) => [f.label, f.value.toLocaleString('en-US')])}
    />
    <script type="application/json" data-chart-spec="peaks" set:html={JSON.stringify(peaksSpec)} is:inline />

    <p>
      The same thing said one grain down. The county's twelve townships are now on record for 1930,
      1940 and 1950, and every one of them holds more people today than it did in 1930 — from Sugar
      Creek, a fifth larger, to Shawnee, six times over. Shawnee and American are the two that
      border Lima on its south and west.
    </p>
    <AssertionCard assertion={townships} />
  </section>

  <script>
    import { renderCharts } from '../scripts/charts'
    renderCharts()
  </script>

  <style>
    section {
      margin-top: 3rem;
    }
  </style>

  <section>
    <h2>The census counted what the history estimated</h2>
    <AssertionCard assertion={counted1920} />
    <p>
      The 1921 county history has a chapter about the county's Black residents, and it opens with an
      estimate: "it is estimated that there are 2,500 negroes in Allen County ... The Allen County
      negroes are nearly all in Lima." The census had been taken the year before. It counted 1,385
      in the county and 1,243 in Lima — so the book is right about where they lived, and out by a
      factor of 1.81 about how many.
    </p>
    <p>
      Its two voter counts are the sharper problem. It says there were 552 Black voters in Lima in
      1916 and, "in 1920, counting the women, there were almost 1,000". A thousand voters in a city
      with 1,243 Black residents would be four out of every five of them, children included. The
      1916 figure is 44.4 per cent of the same population, which is high for adult men and not
      impossible in a community migration had made young and male: the census counts 751 Black males
      in the county against 634 females.
    </p>
    <DataTable
      title="Allen County and Lima in 1920"
      caption="The county's four race lines sum to the printed total of 68,223 and the city's four white lines to the printed 40,062, which is how these figures were checked before they were written down. Lima held 89.7 per cent of the county's Black residents and 60.6 per cent of its people."
      columns={['', 'Allen County', 'Lima']}
      rows={composition1920}
    />
    <p>
      The same book says that "as yet no papers are on file showing the foreign population of Allen
      County", in the paragraph where its congressman opposes "indiscriminate immigration from
      Europe". The count existed. The census had taken it the year before, and it found 2,753
      foreign-born white residents from twenty-one named countries — and, with their native-born
      children, 11,274 people of foreign or mixed stock, one in six of the county.
    </p>
    <ChartFigure
      id="born-1920"
      title="Where the county's foreign-born came from, 1920"
      caption="Twenty-one countries and a residual of 85, summing exactly to the 2,753 the table prints. Switzerland's 171 are Bluffton's Mennonites and Wales's 120 are Gomer; Germany's 627 belong to the country whose name the county had taken off a township two years earlier."
      columns={['Country of birth', 'Residents']}
      rows={counted1920.figures.map((f) => [f.label, f.value])}
    />
    <script type="application/json" data-chart-spec="born-1920" set:html={JSON.stringify(bornSpec)} is:inline />
    <p>
      One more thing fell out of reading the volume: the county's 1920 population is 68,223, not the
      68,203 this site has been printing. That number came from the county history too, and it is
      twenty low — exactly as the same book's figure for Lima, 41,306, is twenty low against the
      census's 41,326. The corpus had already caught the second and never checked the first.
    </p>
    <AssertionCard assertion={forties} />
    <p>
      That 1920 count sat alone for a century, with the next figure this site could give being the
      2023 estimates. The four censuses in between are in the Ohio population volume of each, and
      three of the four have no text layer at all — every number below was read off a rendered page
      image and added up before it was written down.
    </p>
    <ChartFigure
      id="black-population-1920-1960"
      title="Allen County's Black population, 1920 to 1960"
      caption="The First Great Migration, which transformed Detroit, Cleveland and Youngstown between 1916 and 1930, added 301 people to this county and then 230. The decade that moved the number is the 1940s, when Lima was building locomotives and tanks."
      columns={['Census', 'Residents']}
      rows={forties.figures.map((f) => [f.label, f.value])}
    />
    <script type="application/json" data-chart-spec="black-population-1920-1960" set:html={JSON.stringify(migrationSpec)} is:inline />
    <DataTable
      title="Allen County by race and nativity, 1920 to 2023"
      caption="Each census's race lines sum to the printed county total, which is how these were checked. The 1960 county table gives white without splitting it by nativity, which is why the foreign-born series stops at 1950."
      columns={['Census', 'County', 'Black', 'Share', 'Foreign-born white']}
      rows={raceSeries}
    />
    <p>
      The immigrant population went the other way over the same forty years, and it went without
      interruption: 2,753 in 1920, 2,219 in 1930, 1,682 in 1940, 1,485 in 1950 — down 46 per cent
      while the county grew 29. Federal statute closed European immigration in 1924, and the two
      curves cross in the 1930s. By 1950 Italy has passed Germany, 246 to 222, where in 1920 it was
      Germany 627 to Italy 312.
    </p>
    <p>
      Two of the 1920 columns have no 1950 successor at all. Switzerland, whose 171 stood for
      Bluffton, has no column of its own in the later table, and Wales, whose 120 stood for Gomer,
      is folded into England. That is not a fall to nothing; it is a column that stopped being
      printed — which is the reason this phase also wrote down a rule about differencing figures
      that come from two different books.
    </p>
  </section>
</Base>

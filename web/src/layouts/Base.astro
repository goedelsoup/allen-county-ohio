---
import '../styles/tokens.css'
import { manifest } from '../lib/feeds'
import { INSTRUMENTS, SECTIONS } from '../lib/sections'

interface Props {
  title: string
  lede?: string
  /** Entry pages carry the design's own article header, so the page head is suppressed. */
  bare?: boolean
}

const { title, lede, bare = false } = Astro.props
const here = Astro.url.pathname.replace(/\/$/, '') || '/'

const SITE = 'Allen County, Ohio'
// The home page is already called what the site is called; appending it reads as a stutter.
const documentTitle = title === SITE ? SITE : `${title} · ${SITE}`

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={lede ?? 'A civic reference for Allen County, Ohio.'} />
    <link rel="icon" href="data:," />
    {/*
      No <link> to a font CDN, and no preconnect to one.

      There were three, and they were the only thing on this site that reached anywhere at read
      time — the feeds are committed, the geometry is vendored, the build is static. So a
      public civic reference made every reader's browser announce itself to a third party on
      every page load, which is a small thing to fix and an awkward one to explain, and
      `web/README.md` claimed the opposite in as many words.

      The faces are in `public/fonts/`, written by `mise run fonts`, and declared in
      `tokens/fonts.css`. `register.test.ts` fails the build if a request to anywhere comes
      back.
    */}
    <link rel="preload" href="/fonts/eb-garamond-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/im-fell-english-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="head-rule"></div>

    <header class="masthead">
      <div class="masthead-inner">
        <a class="wordmark" href="/">
          <span class="wordmark-name">Allen County</span>
          <span class="wordmark-tags">
            <span class="eyebrow">A civic reference</span>
            <span class="wordmark-tick"></span>
            <span class="eyebrow">Ohio</span>
          </span>
        </a>
      </div>
      <div class="navbar">
        {/*
          Two landmarks, not one landmark and a labelled list.

          The reading row and the instruments are different things — a reader reads the first
          and reaches for the second — and that cut is made in `sections.ts`, in the styling,
          and now in the accessibility tree. It was not: the instruments sat in a <ul> carrying
          `aria-label="Instruments"`, and an accessible name on a list is not a landmark and is
          not announced on entry the way a <nav>'s is. Map, Entries and Sources were read out
          inside the landmark named Sections, on every page, because this is the layout.
        */}
        <div class="nav-inner">
          <nav aria-label="Sections">
            <ul>
              {
                SECTIONS.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      title={item.question}
                      aria-current={here === item.href ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <span class="nav-spacer"></span>
          <nav class="instrument-tabs" aria-label="Instruments">
            <ul>
              {
                INSTRUMENTS.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      title={item.question}
                      aria-current={here.startsWith(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <span class="nav-meta data">Feed v{manifest.feed_version}</span>
        </div>
      </div>
    </header>

    <main id="main">
      {
        !bare && (
          <div class="page-head">
            <h1>{title}</h1>
            {lede && <p class="lede">{lede}</p>}
          </div>
        )
      }
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <p>
          Every claim on this site comes from a corpus of {manifest.corpus.nodes} nodes and
          carries the tag it was written with. Nothing tagged <code>[open]</code> appears here:
          {manifest.corpus.blocks_withheld} paragraphs and {manifest.corpus.properties_withheld}
          {' '}fields were withheld from these pages by the rule, not by an editor.
        </p>
        <p class="fine">
          Feed contract v{manifest.feed_version} · published at the
          <strong>{manifest.policy.ceiling}</strong> ceiling · boundaries from TIGERweb, 2020
          vintage.
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--surface-raised);
        padding: var(--space-4) var(--space-5);
        z-index: 10;
      }
      .skip:focus {
        left: 0;
      }

      /* The ink bar the design puts above every page, before the paper starts. */
      .head-rule {
        height: 4px;
        background: var(--surface-ink);
      }

      .masthead {
        border-bottom: 1px solid var(--ink-400);
        background: var(--surface-card);
        background-image: var(--wash-foxing);
      }
      .masthead-inner {
        max-width: var(--width-content);
        margin: 0 auto;
        padding: var(--space-8) var(--gutter-fluid) var(--space-7);
      }
      .wordmark {
        color: var(--text-strong);
        text-decoration: none;
        display: inline-block;
      }
      .wordmark-name {
        display: block;
        font: var(--weight-regular) var(--size-display-m) / 1 var(--font-display);
        letter-spacing: var(--tracking-display);
      }
      .wordmark-tags {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        margin-top: var(--space-3);
      }
      .wordmark-tick {
        width: 16px;
        height: 1px;
        background: var(--rule-hairline);
      }

      .navbar {
        border-top: 1px solid var(--rule-hairline);
      }
      .nav-inner {
        max-width: var(--width-content);
        margin: 0 auto;
        padding: 0 var(--gutter-fluid);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0 var(--space-7);
      }
      .nav-inner ul {
        display: flex;
        gap: 0 var(--space-7);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-inner a {
        display: block;
        padding: var(--space-4) 0;
        margin-bottom: -1px;
        border-bottom: 2px solid transparent;
        color: var(--text-muted);
        text-decoration: none;
        font-family: var(--font-smallcaps);
        font-size: var(--size-body-s);
        letter-spacing: 0.11em;
        text-transform: uppercase;
        transition: var(--transition-control);
      }
      .nav-inner a:hover {
        color: var(--text-strong);
      }
      .nav-inner a[aria-current='page'] {
        color: var(--text-strong);
        border-bottom-color: var(--rubric-500);
      }

      /*
       * The reading tabs and the instruments are two different things and were
       * one undifferentiated row of thirteen. The instruments are what a reader
       * reaches for; separating them is what stopped the map competing with the
       * history page for the same eye.
       *
       * The rule now hangs on the <nav> that names them rather than on the list
       * inside it, which is the same separation the accessibility tree needed.
       * The reading row carries no class at all: it had one, `reading-tabs`,
       * that no rule anywhere selected — the list was styled by `.nav-inner ul`
       * and this block overrode it. A hook nothing uses reads as a hook
       * something uses.
       */
      .nav-inner .instrument-tabs {
        border-left: 1px solid var(--rule-hairline);
        padding-left: var(--space-7);
      }
      .nav-inner .instrument-tabs ul {
        gap: 0 var(--space-6);
      }
      .nav-inner .instrument-tabs a {
        font-size: var(--size-micro);
        color: var(--text-faint);
        letter-spacing: var(--tracking-label);
      }
      .nav-inner .instrument-tabs a:hover,
      .nav-inner .instrument-tabs a[aria-current='page'] {
        color: var(--text-strong);
      }
      .nav-spacer {
        flex: 1;
      }
      .nav-meta {
        font-size: var(--size-micro);
        color: var(--text-faint);
        margin-left: var(--space-7);
      }

      /*
       * Below the width that fits one row, the nav scrolls rather than wrapping.
       * Thirteen wrapped items were a nine-line slab above every page on a
       * phone; six and three are one line and a swipe.
       */
      @media (width < 58rem) {
        .nav-inner {
          flex-wrap: nowrap;
          overflow-x: auto;
          scrollbar-width: none;
          gap: 0;
        }
        .nav-inner::-webkit-scrollbar {
          display: none;
        }
        /* The flex items are the two landmarks now, not the lists inside them. */
        .nav-inner > nav {
          flex: 0 0 auto;
        }
        .nav-inner a {
          white-space: nowrap;
        }
        .nav-spacer {
          flex: 0 0 var(--space-6);
        }
        .nav-inner .instrument-tabs {
          padding-left: var(--space-6);
        }
        .nav-meta {
          display: none;
        }
      }

      main {
        max-width: var(--width-content);
        margin: 0 auto;
        padding: var(--space-9) var(--gutter-fluid) var(--space-13);
      }
      .page-head {
        max-width: var(--measure-prose);
        margin-bottom: var(--space-10);
      }
      .lede {
        margin: var(--space-5) 0 0;
        font: var(--weight-regular) var(--size-body-l) / 1.5 var(--font-serif);
        color: var(--text-muted);
      }

      footer {
        border-top: 1px solid var(--ink-400);
        background: var(--surface-sunken);
        background-image: var(--paper-grain);
      }
      .footer-inner {
        max-width: var(--width-content);
        margin: 0 auto;
        padding: var(--space-10) var(--gutter-fluid) var(--space-12);
        color: var(--text-muted);
        font: var(--weight-regular) var(--size-body-s) / 1.55 var(--font-serif);
      }
      .footer-inner p {
        max-width: var(--measure-prose);
      }
      .fine {
        margin: 0;
        font: var(--type-data);
        font-size: var(--size-micro);
        color: var(--text-faint);
      }
    </style>
  </body>
</html>
